							error_injection_type {flag '--error-injection-type', default 'transient_error', doc 'Type of error to inject.', source 'megatron/training/config/resilience_config.py:16', origin 'dataclass RerunStateMachineConfig'}
								alternative
									error_injection_type_correct_result {value 'correct_result'}
									error_injection_type_transient_error {value 'transient_error'}
									error_injection_type_persistent_error {value 'persistent_error'}
							rerun_mode {flag '--rerun-mode', default 'validate_results', doc 'Use re-run engine to validate results (default) or to emit stats on variability of computations due to non-deterministic algorithms.', source 'megatron/training/config/resilience_config.py:21', origin 'dataclass RerunStateMachineConfig'}
								alternative
									rerun_mode_disabled {value 'disabled'}
									rerun_mode_validate_results {value 'validate_results'}
									rerun_mode_report_stats {value 'report_stats'}
						optional
							check_for_spiky_loss {flag '--check-for-spiky-loss', default false, doc 'Check for spiky loss.', source 'megatron/training/config/resilience_config.py:28', origin 'dataclass RerunStateMachineConfig'}
					RNGAndInitializationGroup {abstract, title 'RNG and initialization', function '_add_initialization_args', doc 'RNGConfig: Configuration settings for random number generation.', parameters 5}
						mandatory
							Integer seed {flag '--seed', default 1234, doc 'Random seed used for python, numpy, pytorch, and cuda.', source 'megatron/training/config/common_config.py:10', origin 'dataclass RNGConfig'}
						optional
							te_rng_tracker {flag '--te-rng-tracker', default false, doc 'Use the Transformer Engine version of the random number generator. Required for CUDA graphs support.', source 'megatron/training/config/common_config.py:13', origin 'dataclass RNGConfig'}
							inference_rng_tracker {flag '--inference-rng-tracker', default false, doc 'Use a random number generator configured for inference.', source 'megatron/training/config/common_config.py:17', origin 'dataclass RNGConfig'}
							data_parallel_random_init {flag '--data-parallel-random-init', default false, doc 'Enable random initialization of params across data parallel ranks', source 'megatron/training/config/common_config.py:20', origin 'dataclass RNGConfig'}
							init_method_xavier_uniform {flag '--init-method-xavier-uniform', default false, doc 'Enable Xavier uniform parameter initialization', source 'megatron/training/arguments.py:3223', origin 'argparse'}
					LearningRateAndWeightDecayGroup {abstract, title 'learning rate and weight decay', function '_add_learning_rate_args', doc 'SchedulerConfig: Configuration settings for the learning rate scheduler and weight decay.', parameters 21}
						mandatory
							lr_decay_style {flag '--lr-decay-style', default 'linear', doc 'Learning rate decay function.', source 'megatron/training/config/training_config.py:169', origin 'dataclass SchedulerConfig'}
								alternative
									lr_decay_style_constant {value 'constant'}
									lr_decay_style_linear {value 'linear'}
									lr_decay_style_cosine {value 'cosine'}
									lr_decay_style_inverse_square_root {value 'inverse-square-root'}
									lr_decay_style_WSD {value 'WSD'}
							lr_wsd_decay_style {flag '--lr-wsd-decay-style', default 'exponential', doc 'Decay style for the annealing phase of WSD', source 'megatron/training/config/training_config.py:172', origin 'dataclass SchedulerConfig'}
								alternative
									lr_wsd_decay_style_exponential {value 'exponential'}
									lr_wsd_decay_style_linear {value 'linear'}
									lr_wsd_decay_style_cosine {value 'cosine'}
									lr_wsd_decay_style_minus_sqrt {value 'minus_sqrt'}
							Integer lr_warmup_iters {flag '--lr-warmup-iters', default 0, doc 'number of iterations to linearly warmup learning rate over.', source 'megatron/training/config/training_config.py:190', origin 'dataclass SchedulerConfig'}
							Integer lr_warmup_samples {flag '--lr-warmup-samples', default 0, doc 'number of samples to linearly warmup learning rate over.', source 'megatron/training/config/training_config.py:193', origin 'dataclass SchedulerConfig'}
							Real lr_warmup_init {flag '--lr-warmup-init', default 0.0, doc 'Initial value for learning rate warmup. The scheduler starts warmup from this value.', source 'megatron/training/config/training_config.py:196', origin 'dataclass SchedulerConfig'}
							weight_decay_incr_style {flag '--weight-decay-incr-style', default 'constant', doc 'Weight decay increment function.', source 'megatron/training/config/training_config.py:227', origin 'dataclass SchedulerConfig'}
								alternative
									weight_decay_incr_style_constant {value 'constant'}
									weight_decay_incr_style_linear {value 'linear'}
									weight_decay_incr_style_cosine {value 'cosine'}
							Real min_lr {flag '--min-lr', default 0.0, doc 'Minimum value for learning rate. The schedulerclip values below this threshold.', source 'megatron/training/arguments.py:3242', origin 'argparse'}
						optional
							Integer lr_decay_iters {flag '--lr-decay-iters', doc 'number of iterations to decay learning rate over, If None defaults to train iters', source 'megatron/training/config/training_config.py:175', origin 'dataclass SchedulerConfig'}
							Integer lr_decay_samples {flag '--lr-decay-samples', doc 'number of samples to decay learning rate over, If None defaults to train samples', source 'megatron/training/config/training_config.py:178', origin 'dataclass SchedulerConfig'}
							Integer lr_wsd_decay_iters {flag '--lr-wsd-decay-iters', doc 'number of iterations for the annealing phase in the wsd schedule', source 'megatron/training/config/training_config.py:181', origin 'dataclass SchedulerConfig'}
							Integer lr_wsd_decay_samples {flag '--lr-wsd-decay-samples', doc 'number of samples for the annealing phase in the wsd schedule', source 'megatron/training/config/training_config.py:184', origin 'dataclass SchedulerConfig'}
							Real lr_warmup_fraction {flag '--lr-warmup-fraction', doc 'fraction of lr-warmup-(iters/samples) to use for warmup (as a float)', source 'megatron/training/config/training_config.py:187', origin 'dataclass SchedulerConfig'}
							override_opt_param_scheduler {flag '--override-opt_param-scheduler --override-opt-param-scheduler', default false, doc 'Reset the values of the scheduler (learning rate, warmup iterations, minimum learning rate, maximum number of iterations, and decay style) from input arguments and ignore values from checkpoints. Note that all the above values will be reset.', source 'megatron/training/config/training_config.py:209', origin 'dataclass SchedulerConfig'}
							use_checkpoint_opt_param_scheduler {flag '--use-checkpoint-opt_param-scheduler --use-checkpoint-opt-param-scheduler', default false, doc 'Use checkpoint to set the values of the scheduler (learning rate, warmup iterations, minimum learning rate, maximum number of iterations, and decay style) from checkpoint and ignore input arguments.', source 'megatron/training/config/training_config.py:214', origin 'dataclass SchedulerConfig'}
							Real start_weight_decay {flag '--start-weight-decay', doc 'Initial weight decay coefficient for L2 regularization.', source 'megatron/training/config/training_config.py:221', origin 'dataclass SchedulerConfig'}
							Real end_weight_decay {flag '--end-weight-decay', doc 'End of run weight decay coefficient for L2 regularization.', source 'megatron/training/config/training_config.py:224', origin 'dataclass SchedulerConfig'}
							Real lr {flag '--lr', doc 'Initial learning rate. Depending on decay style and initial warmup, the learning rate at each iteration would be different.', source 'megatron/training/arguments.py:3235', origin 'argparse'}
							Integer warmup {flag '--warmup', doc 'Old lr warmup argument, do not use. Use one of the--lr-warmup-* arguments above', source 'megatron/training/arguments.py:3239', origin 'argparse'}
							Real decoupled_lr {flag '--decoupled-lr', doc 'Separate learning rate for the input and output layer', source 'megatron/training/arguments.py:3245', origin 'argparse'}
							Real decoupled_min_lr {flag '--decoupled-min-lr', doc 'Minimum value for learning rate for the input and output layer. The schedulerclip values below this threshold', source 'megatron/training/arguments.py:3247', origin 'argparse'}
							freeze_all_layers {flag '--freeze-all-layers', default false, doc 'Freeze all layers of the model.', source 'megatron/training/arguments.py:3250', origin 'argparse'}
					CheckpointingGroup {abstract, title 'checkpointing', function '_add_checkpointing_args', doc 'CheckpointConfig: Configuration settings for model checkpointing (saving and loading).', parameters 63}
						mandatory
							non_persistent_local_ckpt_algo {flag '--non-persistent-local-ckpt-algo', default 'fully_parallel', doc 'Algorithm for local non-persistent checkpointing.', source 'megatron/training/config/training_config.py:461', origin 'dataclass CheckpointConfig'}
								alternative
									non_persistent_local_ckpt_algo_fully_parallel {value 'fully_parallel'}
									non_persistent_local_ckpt_algo_atomic {value 'atomic'}
							ckpt_format {flag '--ckpt-format', default 'torch_dist', doc 'Checkpoint format to use. torch is the format used by torch.save/load. torch_dist is a megatron built-in distributed checkpointing format. torch_dcp is the torch.distributed.checkpoint format. fsdp_dtensor is a torch DCP native, Megatron FSDP training-specific checkpoint format.', source 'megatron/training/config/training_config.py:486', origin 'dataclass CheckpointConfig'}
								alternative
									ckpt_format_torch {value 'torch'}
									ckpt_format_torch_dist {value 'torch_dist'}
									ckpt_format_torch_dcp {value 'torch_dcp'}
									ckpt_format_fsdp_dtensor {value 'fsdp_dtensor'}
							async_strategy {flag '--async-strategy', default 'nvrx', doc 'Which async save strategy to use. Deprecated and will be removed.', source 'megatron/training/config/training_config.py:519', origin 'dataclass CheckpointConfig'}
								alternative
									async_strategy_nvrx {value 'nvrx'}
							Integer async_ckpt_cpu_priority {flag '--async-ckpt-cpu-priority', default 10, doc 'CPU nice value target (0-19, higher = lower priority) for the async checkpoint writer process. If it exceeds 19, it will be set to 19. If the current nice value is greater than the target, it will be left unchanged. Only applies when using persistent ckpt worker.', source 'megatron/training/config/training_config.py:527', origin 'dataclass CheckpointConfig'}
							Integer async_ckpt_io_priority {flag '--async-ckpt-io-priority', default 3, doc 'I/O scheduling class (0-3, 3=idle) for the async checkpoint writer process.', source 'megatron/training/config/training_config.py:532', origin 'dataclass CheckpointConfig'}
							ckpt_fully_parallel_load_exchange_algo {flag '--ckpt-fully-parallel-load-exchange-algo', default 'broadcast', doc 'Algorithm for fully parallel load of distributed checkpoints. "broadcast"(default): Broadcast the checkpoint from rank 0 to all other ranks. "gather_rounds": Gather the checkpoint from all ranks in rounds. "gather_object": Gather the checkpoint from all ranks in a single operation.', source 'megatron/training/config/training_config.py:544', origin 'dataclass CheckpointConfig'}
								alternative
									ckpt_fully_parallel_load_exchange_algo_broadcast {value 'broadcast'}
									ckpt_fully_parallel_load_exchange_algo_gather_rounds {value 'gather_rounds'}
									ckpt_fully_parallel_load_exchange_algo_gather_object {value 'gather_object'}
							ckpt_fully_parallel_save_process_group {flag '--ckpt-fully-parallel-save-process-group', default 'dp', doc 'Process group for fully parallel save of distributed checkpoints. "dp"(default): Data parallel process group. "ep_dp": Expert data parallel process group.', source 'megatron/training/config/training_config.py:559', origin 'dataclass CheckpointConfig'}
								alternative
									ckpt_fully_parallel_save_process_group_dp {value 'dp'}
									ckpt_fully_parallel_save_process_group_ep_dp {value 'ep_dp'}
							ckpt_fully_parallel_load_process_group {flag '--ckpt-fully-parallel-load-process-group', default 'dp', doc 'Process group for fully parallel load of distributed checkpoints. "dp"(default): Data parallel process group. "ep_dp": Expert data parallel process group.', source 'megatron/training/config/training_config.py:565', origin 'dataclass CheckpointConfig'}
								alternative
									ckpt_fully_parallel_load_process_group_dp {value 'dp'}
									ckpt_fully_parallel_load_process_group_ep_dp {value 'ep_dp'}
							dist_ckpt_strictness {flag '--dist-ckpt-strictness', default 'assume_ok_unexpected', doc 'Determine handling of key mismatch during checkpoint load. Check StrictHandling docs for flags meaning. NOTE: This flag controls only distributed checkpoint load from storage, not loading state dict into the model. For fsdp_dtensor checkpoints it covers model weights a partial load cannot supply, and assume_ok_unexpected raises like raise_unexpected there because a partial load never raises on its own. Use ignore_all to opt out.', source 'megatron/training/config/training_config.py:603', origin 'dataclass CheckpointConfig'}
								alternative
									dist_ckpt_strictness_assume_ok_unexpected {value 'assume_ok_unexpected'}
									dist_ckpt_strictness_log_unexpected {value 'log_unexpected'}
									dist_ckpt_strictness_log_all {value 'log_all'}
									dist_ckpt_strictness_raise_unexpected {value 'raise_unexpected'}
									dist_ckpt_strictness_raise_all {value 'raise_all'}
									dist_ckpt_strictness_return_unexpected {value 'return_unexpected'}
									dist_ckpt_strictness_return_all {value 'return_all'}
									dist_ckpt_strictness_ignore_all {value 'ignore_all'}
							Integer replication_factor {flag '--replication-factor', default 2, doc 'Number of machines storing the replica of a given rank`s data.', source 'megatron/training/config/training_config.py:645', origin 'dataclass CheckpointConfig'}
							Integer dist_ckpt_workers {flag '--dist-ckpt-workers', default 1, doc 'Number of workers for distributed checkpointing. Only used for async save. If set to 1, the checkpointing is performed in a single process.', source 'megatron/training/arguments.py:3280', origin 'argparse'}
						optional
							String save {flag '--save', doc 'Output directory to save checkpoints to.', source 'megatron/training/config/training_config.py:395', origin 'dataclass CheckpointConfig'}
							Integer save_interval {flag '--save-interval --persistent-save-interval', doc 'Number of iterations between persistent checkpoint saves.', source 'megatron/training/config/training_config.py:398', origin 'dataclass CheckpointConfig'}
							Integer save_params_interval {flag '--save-params-interval', doc 'Number of iterations between param.name->param.data mapping saves.', source 'megatron/training/config/training_config.py:401', origin 'dataclass CheckpointConfig'}
							Integer save_activations_interval {flag '--save-activations-interval', doc 'Number of iterations between act.name->act.data mapping saves.', source 'megatron/training/config/training_config.py:404', origin 'dataclass CheckpointConfig'}
							Integer save_tokens_per_expert_interval {flag '--save-tokens-per-expert-interval', doc 'Number of iterations between tokens-per-expert routing metadata saves.', source 'megatron/training/config/training_config.py:407', origin 'dataclass CheckpointConfig'}
							Integer save_wgrads_interval {flag '--save-wgrads-interval', doc 'Number of iterations between wgrad (main_grad) saves.', source 'megatron/training/config/training_config.py:410', origin 'dataclass CheckpointConfig'}
							Integer save_dgrads_interval {flag '--save-dgrads-interval', doc 'Number of iterations between dgrad saves.', source 'megatron/training/config/training_config.py:413', origin 'dataclass CheckpointConfig'}
							Integer save_retain_interval {flag '--save-retain-interval', doc 'Number of iterations between retained checkpoints (other checkpoints except the last checkpoint are automatically deleted).', source 'megatron/training/config/training_config.py:416', origin 'dataclass CheckpointConfig'}
							String load {flag '--load', doc 'Directory containing a model checkpoint.', source 'megatron/training/config/training_config.py:430', origin 'dataclass CheckpointConfig'}
							load_main_params_from_ckpt {flag '--load-main-params-from-ckpt', default false, doc 'Load main parameters from checkpoint. When loading a model from a checkpoint without loading the optimizer, the model parameters are updated but for fp16 optimizer with main parameters, the main parameters need to also be updated.', source 'megatron/training/config/training_config.py:436', origin 'dataclass CheckpointConfig'}
							Integer non_persistent_save_interval {flag '--non-persistent-save-interval', doc 'Number of iterations between non-persistent saves.', source 'megatron/training/config/training_config.py:445', origin 'dataclass CheckpointConfig'}
							non_persistent_ckpt_type {flag '--non-persistent-ckpt-type', doc 'Type of non-persistent model checkpoints. "global" - Saved as a standard checkpoint (e.g., on Lustre) with old checkpoints being removed. "local" - [TBD] Each rank saves a portion of the checkpoint locally (e.g., on SSD/ramdisk). "in_memory" - [TBD] A special kind of local checkpoint that avoids serialization. None - No non-persistent checkpointing (default option).', source 'megatron/training/config/training_config.py:448', origin 'dataclass CheckpointConfig'}
								alternative
									non_persistent_ckpt_type_global {value 'global'}
									non_persistent_ckpt_type_local {value 'local'}
									non_persistent_ckpt_type_in_memory {value 'in_memory'}
							String non_persistent_global_ckpt_dir {flag '--non-persistent-global-ckpt-dir', doc 'Directory containing global non-persistent model checkpoints.', source 'megatron/training/config/training_config.py:455', origin 'dataclass CheckpointConfig'}
							String non_persistent_local_ckpt_dir {flag '--non-persistent-local-ckpt-dir', doc 'Directory containing local non-persistent model checkpoints.', source 'megatron/training/config/training_config.py:458', origin 'dataclass CheckpointConfig'}
							finetune {flag '--finetune', default false, doc 'Load model for finetuning. Do not load optimizer or rng state from checkpoint and set iteration to 0. Assumed when loading a release checkpoint.', source 'megatron/training/config/training_config.py:464', origin 'dataclass CheckpointConfig'}
							String pretrained_checkpoint {flag '--pretrained-checkpoint', doc 'Directory containing a pretrained model checkpoint for finetuning.', source 'megatron/training/config/training_config.py:468', origin 'dataclass CheckpointConfig'}
							Integer ckpt_step {flag '--ckpt-step', doc 'Checkpoint step to load model from.', source 'megatron/training/config/training_config.py:471', origin 'dataclass CheckpointConfig'}
							use_checkpoint_args {flag '--use-checkpoint-args', default false, doc 'Override model-related command-line arguments with arguments from checkpoint', source 'megatron/training/config/training_config.py:474', origin 'dataclass CheckpointConfig'}
							use_mp_args_from_checkpoint_args {flag '--use-mp-args-from-checkpoint-args', default false, doc 'Copy model parallelism command-line arguments from checkpoint', source 'megatron/training/config/training_config.py:477', origin 'dataclass CheckpointConfig'}
							use_tokenizer_model_from_checkpoint_args {flag '--no-use-tokenizer-model-from-checkpoint-args --disable-use-tokenizer-model-from-checkpoint-args', default true, doc 'If set, do not use tokenizer model path from checkpoint', source 'megatron/training/config/training_config.py:480', origin 'dataclass CheckpointConfig'}
							exit_on_missing_checkpoint {flag '--exit-on-missing-checkpoint', default false, doc 'If `load` is set, but checkpoint is not found (e.g., path typo), then exit instead of random initialization.', source 'megatron/training/config/training_config.py:483', origin 'dataclass CheckpointConfig'}
							auto_detect_ckpt_format {flag '--auto-detect-ckpt-format', default false, doc 'Determine if the checkpoint format is in legacy or distributed format. If False, expects distributed checkpoint iff args.ckpt_format != "torch". Might slow down loading a bit (double rank0 ckpt load).', source 'megatron/training/config/training_config.py:493', origin 'dataclass CheckpointConfig'}
							ckpt_convert_format {flag '--ckpt-convert-format', doc 'Checkpoint format for conversion.', source 'megatron/training/config/training_config.py:499', origin 'dataclass CheckpointConfig'}
								alternative
									ckpt_convert_format_torch {value 'torch'}
									ckpt_convert_format_torch_dist {value 'torch_dist'}
							String ckpt_convert_save {flag '--ckpt-convert-save', doc 'Save directory for converted checkpoint.', source 'megatron/training/config/training_config.py:502', origin 'dataclass CheckpointConfig'}
							ckpt_convert_update_legacy_dist_opt_format {flag '--ckpt-convert-update-legacy-dist-opt-format', default false, doc 'When loading a checkpoint, update the legacy format for the distributed optimizer, which previously used a merged param/grad buffer and a different bucket mapping. The legacy format was deprecated on Feb 13, 2024.', source 'megatron/training/config/training_config.py:505', origin 'dataclass CheckpointConfig'}
							ckpt_fully_parallel_save {flag '--no-ckpt-fully-parallel-save', default true, doc 'Disable applying full save parallelization across DP for distributed checkpoints. Depending on ckpt format might decrease the number of files in the checkpoint. Makes DistributedOptimizer checkpoint non-reshardable.', source 'megatron/training/config/training_config.py:511', origin 'dataclass CheckpointConfig'}
							async_save {flag '--async-save', default false, doc 'Apply async checkpointing save. Currently works only with `torch_dist` distributed checkpoint format.', source 'megatron/training/config/training_config.py:516', origin 'dataclass CheckpointConfig'}
							use_persistent_ckpt_worker {flag '--use-persistent-ckpt-worker', default false, doc 'Use a persistent background worker for async checkpoint saves. When enabled, creates a dedicated worker thread/process for handling async saves. When disabled, uses temporal workers that are created and destroyed for each save operation.', source 'megatron/training/config/training_config.py:522', origin 'dataclass CheckpointConfig'}
							async_ckpt_use_cpu_shm {flag '--async-ckpt-use-cpu-shm', default false, doc 'Copy GPU tensors to CPU shared-memory in the training process before handing off to the async checkpoint worker. Avoids CUDA IPC / NVLink fabric handles in the worker subprocess. Useful on MNNVL systems where fabric resources are exhausted. Only applies with the nvrx async strategy.', source 'megatron/training/config/training_config.py:535', origin 'dataclass CheckpointConfig'}
							ckpt_fully_parallel_load {flag '--ckpt-fully-parallel-load', default false, doc 'Apply full load parallelization across DP for distributed checkpoints.', source 'megatron/training/config/training_config.py:541', origin 'dataclass CheckpointConfig'}
							ckpt_fully_parallel_load_per_rank_objects {flag '--ckpt-fully-parallel-load-per-rank-objects', default false, doc 'Load ShardedObjects per-rank during fully parallel load of distributed checkpoints. When True, every rank reads all of its own ShardedObjects (RNG states, TE `_extra_state`, ...) directly from storage, which removes the WORLD-wide `all_gather_object` that otherwise exchanges them. Objects are content-addressable by `unique_key`, so the loaded values are identical. When False (default), the legacy gather-based object exchange is used.', source 'megatron/training/config/training_config.py:551', origin 'dataclass CheckpointConfig'}
							ckpt_assume_constant_structure {flag '--ckpt-assume-constant-structure', default false, doc 'Assume the checkpoint structure is constant across saves to enable optimizations.', source 'megatron/training/config/training_config.py:571', origin 'dataclass CheckpointConfig'}
							String ckpt_pg_tensors_cache_path {flag '--ckpt-pg-tensors-cache-path', doc 'Directory of the parallelization-group distribution cache for fully parallel save/load of distributed checkpoints. When set, the expensive ``all_gather_object`` in ``determine_main_replica_uniform_distribution`` is replaced by a single per-group file read (the load and save distributions are loaded from this directory). Only safe when the config and world size match the run that created the cache (see ``--ckpt-pg-tensors-cache-create``); no existence/validity checks are performed, for the lowest possible latency. Default (None) preserves the original collective-based behaviour.', source 'megatron/training/config/training_config.py:574', origin 'dataclass CheckpointConfig'}
							ckpt_pg_tensors_cache_create {flag '--ckpt-pg-tensors-cache-create', default false, doc 'Create (rather than read) the parallelization-group distribution cache at ``--ckpt-pg-tensors-cache-path``. Set this for a single run with a matching config/world size: the collective runs as usual but both the save and load distributions are derived from that single gather and written to disk, one file per parallelization group. Subsequent runs set only ``--ckpt-pg-tensors-cache-path`` (leave this False) to skip the collective. Default: False.', source 'megatron/training/config/training_config.py:584', origin 'dataclass CheckpointConfig'}
							ckpt_load_validate_sharding_integrity {flag '--no-ckpt-load-validate-sharding-integrity --disable-ckpt-load-validate-sharding-integrity', default true, doc 'Whether to validate sharding access integrity when loading *and saving* a distributed checkpoint. When True (default), each tensor shard is checked to be accessed exactly once as main replica by some rank. Disabling skips this validation; on save this also skips the world-wide determine_global_metadata all_gather_object (otherwise run on the first save of a job).', source 'megatron/training/config/training_config.py:593', origin 'dataclass CheckpointConfig'}
							strict_fsdp_dtensor_load {flag '--no-strict-fsdp-dtensor-load --disable-strict-fsdp-dtensor-load', default true, doc 'Whether to enforce strict loading for FSDP DTensor checkpoints. When False, allows partial loading.', source 'megatron/training/config/training_config.py:600', origin 'dataclass CheckpointConfig'}
							dist_ckpt_save_pre_mcore_014 {flag '--dist-ckpt-save-pre-mcore-014', default false, doc 'Revert checkpointing simplifications introduced in Megatron-Core v0.14. This option affects only checkpoint saving format and will be removed soon (checkpoint load format is determined based on checkpoint metadata).', source 'megatron/training/config/training_config.py:619', origin 'dataclass CheckpointConfig'}
							dist_ckpt_optim_fully_reshardable {flag '--dist-ckpt-optim-fully-reshardable', default false, doc 'Make optimizer distributed checkpoint fully reshardable (TP/PP/EP/DP) as opposed to plain DP reshardability.', source 'megatron/training/config/training_config.py:624', origin 'dataclass CheckpointConfig'}
							distrib_optim_fully_reshardable_mem_efficient {flag '--distrib-optim-fully-reshardable-mem-efficient', default false, doc 'During distributed optimizer checkpoint save and load tries to use as little memory as possible by using Gloo (instead of NCCL) and only one rank for saving. Turn on only if experiencing host or device memory issues. Has affect only with `dist_ckpt_optim_fully_reshardable` flag.', source 'megatron/training/config/training_config.py:627', origin 'dataclass CheckpointConfig'}
							save_tokenizer_assets {flag '--no-save-tokenizer-assets --disable-save-tokenizer-assets', default true, doc 'Save tokenizer files to checkpoint directory. When enabled, saves all tokenizer artifacts (vocab files, special tokens, tokenizer config) to make checkpoints self-contained and portable. Set to False for performance-sensitive scenarios where tokenizer files are not needed.', source 'megatron/training/config/training_config.py:632', origin 'dataclass CheckpointConfig'}
							replication {flag '--replication', default false, doc 'If set, replication of local checkpoints is enabled. Needs to be enabled on all ranks.', source 'megatron/training/config/training_config.py:637', origin 'dataclass CheckpointConfig'}
							Integer replication_jump {flag '--replication-jump', doc 'Specifies `J`, the spacing between ranks storing replicas of a given rank`s data. Replicas for rank `n` may be on ranks `n+J`, `n+2J`, ..., or `n-J`, `n-2J`, etc. This flag has an effect only if --replication is used. and must be consistent across all ranks.', source 'megatron/training/config/training_config.py:640', origin 'dataclass CheckpointConfig'}
							verify_integrity {flag '--verify-integrity', default false, doc 'Whether to hash checkpointing files during save and validate their integrity during load.', source 'megatron/training/config/training_config.py:648', origin 'dataclass CheckpointConfig'}
							no_save_optim {flag '--no-save-optim', doc 'Do not save current optimizer.', source 'megatron/training/arguments.py:3262', origin 'argparse'}
							no_save_rng {flag '--no-save-rng', doc 'Do not save current rng state.', source 'megatron/training/arguments.py:3264', origin 'argparse'}
							no_load_optim {flag '--no-load-optim', doc 'Do not load optimizer when loading checkpoint.', source 'megatron/training/arguments.py:3266', origin 'argparse'}
							no_load_rng {flag '--no-load-rng', doc 'Do not load rng state when loading checkpoint.', source 'megatron/training/arguments.py:3268', origin 'argparse'}
							Integer override_ckpt_iteration {flag '--override-ckpt-iteration', doc 'Override the iteration stored in the loaded checkpoint. Also resets consumed_train_samples accordingly so the data loader replays samples from that iteration onward.', source 'megatron/training/arguments.py:3270', origin 'argparse'}
							use_dist_ckpt_deprecated {flag '--use-dist-ckpt', default false, doc 'Deprecated: see --ckpt-format.', source 'megatron/training/arguments.py:3274', origin 'argparse'}
							String dist_ckpt_format_deprecated {flag '--dist-ckpt-format', doc 'Deprecated: see --ckpt-format.', source 'megatron/training/arguments.py:3277', origin 'argparse'}
							ckpt_fully_parallel_save_deprecated {flag '--ckpt-fully-parallel-save', default false, doc 'Deprecated: see --no-ckpt-fully-parallel-save.', source 'megatron/training/arguments.py:3284', origin 'argparse'}
							ckpt_drop_redundant_extra_state {flag '--ckpt-drop-redundant-extra-state', default false, doc 'Drop TE `_extra_state` artifacts that carry no irreplaceable state (no FP8, or block/current FP8 scaling) from the distributed checkpoint, keeping them local instead of writing them. Only delayed-scaling `_extra_state` (amax history + scale) is ever needed and it is always persisted regardless of this flag. By default (flag off) all `_extra_state` are persisted, preserving the previous behavior. Older checkpoints load unchanged either way.', source 'megatron/training/arguments.py:3287', origin 'argparse'}
					MixedPrecisionGroup {abstract, title 'mixed precision', function '_add_mixed_precision_args', parameters 12}
						mandatory
							Real initial_loss_scale {flag '--initial-loss-scale', default '2**32', doc 'Initial loss-scale for dynamic loss scaling.', source 'megatron/training/arguments.py:3310', origin 'argparse'}
							Real min_loss_scale {flag '--min-loss-scale', default 1.0, doc 'Minimum loss scale for dynamic loss scaling.', source 'megatron/training/arguments.py:3312', origin 'argparse'}
							Real loss_scale_window {flag '--loss-scale-window', default 1000, doc 'Window over which to raise/lower dynamic scale.', source 'megatron/training/arguments.py:3314', origin 'argparse'}
							Integer hysteresis {flag '--hysteresis', default 2, doc 'hysteresis for dynamic loss scaling', source 'megatron/training/arguments.py:3316', origin 'argparse'}
						optional
							grad_reduce_in_bf16 {flag '--grad-reduce-in-bf16', default false, doc 'Reduce gradients in bfloat16.', source 'megatron/training/arguments.py:3304', origin 'argparse'}
							Real loss_scale {flag '--loss-scale', doc 'Static loss scaling, positive power of 2 values can improve fp16 convergence. If None, dynamicloss scaling is used.', source 'megatron/training/arguments.py:3306', origin 'argparse'}
							attention_softmax_in_fp32 {flag '--attention-softmax-in-fp32', default false, doc 'Run attention masking and softmax in fp32.', source 'megatron/training/arguments.py:3318', origin 'argparse'}
							accumulate_allreduce_grads_in_fp32 {flag '--accumulate-allreduce-grads-in-fp32', default false, doc 'Gradient accumulation and all-reduce in fp32.', source 'megatron/training/arguments.py:3320', origin 'argparse'}
							fp16_lm_cross_entropy {flag '--fp16-lm-cross-entropy', default false, doc 'Move the cross entropy unreduced loss calculationfor lm head to fp16.', source 'megatron/training/arguments.py:3323', origin 'argparse'}
							logit_dtype {flag '--output-logit-dtype', doc 'Output dtype for the language-model output-layer GEMM. When the requested dtype differs from the input dtype, Transformer Engine general_gemm is used. By default, logits use the output-layer input dtype.', source 'megatron/training/arguments.py:3326', origin 'argparse'}
								alternative
									logit_dtype_bf16 {value 'bf16'}
									logit_dtype_fp32 {value 'fp32'}
							reuse_grad_buf_for_mxfp8_param_ag {flag '--reuse-grad-buf-for-mxfp8-param-ag', default false, doc 'If True, reuse the grad buffer for MXFP8 parameter all-gather.', source 'megatron/training/arguments.py:3331', origin 'argparse'}
							mamba_training_ssm_states_dtype {flag '--mamba-training-ssm-states-dtype', doc 'Dtype of the materialized inter-chunk SSM states in Mamba training', source 'megatron/training/arguments.py:3333', origin 'argparse'}
								alternative
									mamba_training_ssm_states_dtype_fp32 {value 'fp32'}
									mamba_training_ssm_states_dtype_bf16 {value 'bf16'}
					DistributedInitGroup {abstract, title 'distributed init', function '_add_distributed_args', doc 'DistributedInitConfig: Configuration settings for distributed training initialization.', parameters 65}
						mandatory
							distributed_backend {flag '--distributed-backend', default 'nccl', doc 'Which backend to use for distributed training.', source 'megatron/training/config/common_config.py:88', origin 'dataclass DistributedInitConfig'}
								alternative
									distributed_backend_nccl {value 'nccl'}
									distributed_backend_gloo {value 'gloo'}
							Integer distributed_timeout_minutes {flag '--distributed-timeout-minutes', default 10, doc 'Timeout minutes for torch.distributed.', source 'megatron/training/config/common_config.py:91', origin 'dataclass DistributedInitConfig'}
							Integer local_rank {flag '--local-rank', default 'int(os.getenv("LOCAL_RANK", "0"))', doc 'local rank passed from distributed launcher.', source 'megatron/training/config/common_config.py:99', origin 'dataclass DistributedInitConfig'}
							Integer flight_recorder_trace_buffer_size {flag '--flight-recorder-trace-buffer-size', default 2000, doc 'Size of the NCCL flight recorder trace buffer (TORCH_NCCL_TRACE_BUFFER_SIZE).', source 'megatron/training/config/common_config.py:151', origin 'dataclass DistributedInitConfig'}
							megatron_fsdp_version {flag '--megatron-fsdp-version', default 1, doc 'Megatron-FSDP implementation version. Defaults to 1.', source 'megatron/training/arguments.py:3409', origin 'argparse'}
								alternative
									megatron_fsdp_version_1 {value 1}
									megatron_fsdp_version_2 {value 2}
							data_parallel_sharding_strategy {flag '--data-parallel-sharding-strategy', default 'optim_grads_params', doc 'Sharding strategy of data parallelism.', source 'megatron/training/arguments.py:3441', origin 'argparse'}
								alternative
									data_parallel_sharding_strategy_no_shard {value 'no_shard'}
									data_parallel_sharding_strategy_optim {value 'optim'}
									data_parallel_sharding_strategy_optim_grads {value 'optim_grads'}
									data_parallel_sharding_strategy_optim_grads_params {value 'optim_grads_params'}
							outer_dp_sharding_strategy {flag '--outer-dp-sharding-strategy', default 'no_shard', doc 'Sharding strategy for outer data parallel group in Hybrid Sharded Data Parallel (HSDP) mode. Valid values are "no_shard" (DP Replication) and "optim" (Optimizer State Hybrid Sharding). The "optim" option is only supported when --data-parallel-sharding-strategy is "optim_grads_params". This option is only effective when Hybrid FSDP is enabled (i.e., when dp_outer_dim is not None). Default: "no_shard".', source 'megatron/training/arguments.py:3453', origin 'argparse'}
								alternative
									outer_dp_sharding_strategy_no_shard {value 'no_shard'}
									outer_dp_sharding_strategy_optim {value 'optim'}
							Integer num_distributed_optimizer_instances {flag '--num-distributed-optimizer-instances', default 1, doc 'Number of Distributed Optimizer copies across Data Parallel domain.', source 'megatron/training/arguments.py:3486', origin 'argparse'}
							String cp_comm_type {flag '--cp-comm-type', default '[`p2p`]', doc 'Inter-gpu communication type for context parallelism: p2p, a2a, allgather or a2a+p2p. If a single string is provided, all layers will share the same communication type. Users can also specify separated types for each layer like --cp-comm-type p2p p2p a2a a2a a2a+p2p a2a+p2p', source 'megatron/training/arguments.py:3491', origin 'argparse', nargs '+'}
						optional
							align_grad_reduce {flag '--no-align-grad-reduce --disable-align-grad-reduce', default true, doc 'If not set, all PP stages will launch gradient reduces simultaneously. Otherwise, each PP stage will independently launch as needed.', source 'megatron/training/config/common_config.py:94', origin 'dataclass DistributedInitConfig'}
							lazy_mpu_init {flag '--lazy-mpu-init', default false, doc 'If set to True, initialize_megatron() skips DDP initialization and returns function to complete it instead. Also turns on --use-cpu-initialization flag. This is for external DDP manager.', source 'megatron/training/config/common_config.py:102', origin 'dataclass DistributedInitConfig'}
							use_megatron_fsdp {flag '--use-megatron-fsdp', default false, doc 'Use Megatron`s Fully Sharded Data Parallel. Cannot be used together with use_torch_fsdp2.', source 'megatron/training/config/common_config.py:106', origin 'dataclass DistributedInitConfig'}
							use_torch_fsdp2 {flag '--use-torch-fsdp2', default false, doc 'Use the torch FSDP2 implementation. FSDP2 is not currently working with Pipeline Parallel. It is still not in a stable release stage, and may therefore contain bugs or other potential issues.', source 'megatron/training/config/common_config.py:109', origin 'dataclass DistributedInitConfig'}
							String nccl_communicator_config_path {flag '--nccl-communicator-config-path', doc 'Path to the yaml file with NCCL communicator configurations. The number of min/max thread groups and thread group cluster size of each communicator can be configured by setting `min_ctas`, `max_ctas`, and `cga_cluster_size`.', source 'megatron/training/config/common_config.py:114', origin 'dataclass DistributedInitConfig'}
							use_tp_pp_dp_mapping {flag '--use-tp-pp-dp-mapping', default false, doc 'If set, distributed ranks initialize order is changed from tp-cp-ep-dp-pp to tp-cp-ep-pp-dp.', source 'megatron/training/config/common_config.py:119', origin 'dataclass DistributedInitConfig'}
							use_gloo_process_groups {flag '--disable-gloo-process-groups', default true, doc 'If enabled, create Gloo process groups for communications.', source 'megatron/training/config/common_config.py:123', origin 'dataclass DistributedInitConfig'}
							use_sharp {flag '--use-sharp', default false, doc 'Set the use of SHARP for the collective communications of data-parallel process groups. When `True`, run barrier within each data-parallel process group, which specifies the SHARP application target groups.', source 'megatron/training/config/common_config.py:126', origin 'dataclass DistributedInitConfig'}
							sharp_enabled_group {flag '--sharp-enabled-group', doc 'IB SHARP can be enabled from only one communication group. By default, it is enabled from dp group if not specified and use_sharp=True. Available options: [dp, dp_replica]', source 'megatron/training/config/common_config.py:132', origin 'dataclass DistributedInitConfig'}
								alternative
									sharp_enabled_group_dp {value 'dp'}
									sharp_enabled_group_dp_replica {value 'dp_replica'}
							String high_priority_stream_groups {flag '--high-priority-stream-groups', default '[]', doc 'Specify which communicator groups should use high priority streams during creation. Assigning high priority to communication streams ensures that communication kernels are scheduled with higher priority, minimizing the exposed communication when it is overlapped with other computation kernels.', source 'megatron/training/config/common_config.py:138', origin 'dataclass DistributedInitConfig', nargs '+'}
							Integer distributed_timeout_seconds_after_init {flag '--distributed-timeout-seconds-after-init', doc 'Timeout in seconds for process groups after initialization. This timeout is applied to all process groups after initialization and the first iteration completes.', source 'megatron/training/config/common_config.py:145', origin 'dataclass DistributedInitConfig'}
							String flight_recorder_dump_path {flag '--flight-recorder-dump-path', doc 'Path for NCCL flight recorder trace dumps. Sets TORCH_FR_DUMP_TEMP_FILE and TORCH_NCCL_DEBUG_INFO_TEMP_FILE env variables before distributed init.', source 'megatron/training/config/common_config.py:148', origin 'dataclass DistributedInitConfig'}
							flight_recorder_dump_on_timeout {flag '--no-flight-recorder-dump-on-timeout --disable-flight-recorder-dump-on-timeout', default true, doc 'Dump flight recorder traces on NCCL timeout (TORCH_NCCL_DUMP_ON_TIMEOUT).', source 'megatron/training/config/common_config.py:154', origin 'dataclass DistributedInitConfig'}
							flight_recorder_include_stack_trace {flag '--flight-recorder-include-stack-trace', default false, doc 'Include stack traces in flight recorder dumps (TORCH_INCLUDE_STACK_TRACE).', source 'megatron/training/config/common_config.py:157', origin 'dataclass DistributedInitConfig'}
							flight_recorder_include_only_active {flag '--no-flight-recorder-include-only-active --disable-flight-recorder-include-only-active', default true, doc 'Include only active operations in flight recorder dumps (TORCH_INCLUDE_ONLY_ACTIVE).', source 'megatron/training/config/common_config.py:160', origin 'dataclass DistributedInitConfig'}
							flight_recorder_extra_dump_on_exec {flag '--no-flight-recorder-extra-dump-on-exec --disable-flight-recorder-extra-dump-on-exec', default true, doc 'Enable extra flight recorder dump on execution (TORCH_NCCL_EXTRA_DUMP_ON_EXEC).', source 'megatron/training/config/common_config.py:163', origin 'dataclass DistributedInitConfig'}
							disable_jit_fuser {flag '--disable-jit-fuser', default false, doc 'Disable the JIT fuser.', source 'megatron/training/config/common_config.py:166', origin 'dataclass DistributedInitConfig'}
							Integer decoder_first_pipeline_num_layers {flag '--decoder-first-pipeline-num-layers', doc 'The number of transformer layers on the first pipeline stage of the decoder. Default None is even split of transformer layers across all pipeline stages', source 'megatron/training/arguments.py:3346', origin 'argparse'}
							Integer decoder_last_pipeline_num_layers {flag '--decoder-last-pipeline-num-layers', doc 'The number of transformer layers on the last pipeline stage of the decoder. Default None is even split of transformer layers across all pipeline stages', source 'megatron/training/arguments.py:3350', origin 'argparse'}
							String pipeline_model_parallel_layout {flag '--pipeline-model-parallel-layout', doc 'A string that describes a custom pipeline model parallel layout. e.g., "E|(t|)*3,m|m||L". E, L, t, m denotes embedding, loss, transformer decoder layer, and mtp layer, respectively. Stages are split by "|". Replicated stages or layers can be described with multiplication. Commas can be used cosmetically. Default None is not using this argument to set the layout.', source 'megatron/training/arguments.py:3354', origin 'argparse'}
							Integer model_parallel_size {flag '--model-parallel-size', doc 'Old model parallel argument, do not use. Use --tensor-model-parallel-size instead.', source 'megatron/training/arguments.py:3362', origin 'argparse'}
							Integer num_layers_per_virtual_pipeline_stage {flag '--num-layers-per-virtual-pipeline-stage', doc 'Number of layers per virtual pipeline stage', source 'megatron/training/arguments.py:3365', origin 'argparse'}
							Integer num_virtual_stages_per_pipeline_rank {flag '--num-virtual-stages-per-pipeline-rank', doc 'Number of virtual pipeline stages per pipeline parallelism rank', source 'megatron/training/arguments.py:3367', origin 'argparse'}
							overlap_p2p_comm {flag '--no-overlap-p2p-communication', default true, doc 'overlap pipeline parallel communication with forward and backward chunks in 1F1B', source 'megatron/training/arguments.py:3369', origin 'argparse'}
							overlap_grad_reduce {flag '--overlap-grad-reduce', default false, doc 'If set, overlap DDP grad reduce.', source 'megatron/training/arguments.py:3372', origin 'argparse'}
							Integer ddp_num_buckets {flag '--ddp-num-buckets', doc 'Number of buckets for data-parallel communication', source 'megatron/training/arguments.py:3374', origin 'argparse'}
							Integer ddp_bucket_size {flag '--ddp-bucket-size', doc 'Bucket size for data-parallel communication', source 'megatron/training/arguments.py:3376', origin 'argparse'}
							ddp_pad_buckets_for_high_nccl_busbw {flag '--ddp-pad-buckets-for-high-nccl-busbw', default false, doc 'If set, make sure the bucket size is divisible by a large power of 2 (2^16) to ensure NCCL collectives have high bus bandwidth at large DP counts, since NCCL message size (which for ring algorithms is bucket_size / dp_size) apparently needs to be divisible by a power of 2 for high busbw.', source 'megatron/training/arguments.py:3378', origin 'argparse'}
							ddp_reduce_scatter_with_fp32_accumulation {flag '--ddp-reduce-scatter-with-fp32-accumulation', default false, doc 'If set, use a reduce-scatter implementation which sends lower-precision values over the wire (using an all-to-all to keep total communication overhead in line with the standard ring implementation) but performs accumulation locally in FP32.', source 'megatron/training/arguments.py:3383', origin 'argparse'}
							gtp_remat_reduce_scatter_with_fp32_accumulation {flag '--gtp-remat-reduce-scatter-with-fp32-accumulation', default false, doc 'Same trade as --ddp-reduce-scatter-with-fp32-accumulation, but for the wgrad reduce-scatter GTP weight-remat performs over the gtp_remat axis: send low-precision values over the wire via an all-to-all and accumulate locally in FP32. Independent of the DDP flag (different collective, different process group). Costs one extra unsharded-wgrad-sized scratch buffer per in-flight reduce-scatter.', source 'megatron/training/arguments.py:3387', origin 'argparse'}
							String ddp_param_name_patterns_for_fp32_local_accumulation {flag '--ddp-param-name-patterns-for-fp32-local-accumulation', default '[]', doc 'List of param_name patterns (in Python`s fnmatch format) to match against to do local gradient accumulation in FP32. The special pattern `all` matches every parameter.', source 'megatron/training/arguments.py:3393', origin 'argparse', nargs '+'}
							ddp_average_in_collective {flag '--ddp-average-in-collective', default false, doc 'If set, average directly in data-parallel communication collective.', source 'megatron/training/arguments.py:3397', origin 'argparse'}
							overlap_param_gather {flag '--overlap-param-gather', default false, doc 'If set, overlap param all-gather in distributed optimizer.', source 'megatron/training/arguments.py:3399', origin 'argparse'}
							overlap_param_gather_with_optimizer_step {flag '--overlap-param-gather-with-optimizer-step', default false, doc 'If set, overlap param all-gather of first bucket with optimizer step.', source 'megatron/training/arguments.py:3401', origin 'argparse'}
							align_param_gather {flag '--no-align-param-gather', default true, doc 'If not set, all PP stages will launch param all-gathers simultaneously. Otherwise, each PP stage will independently launch as needed.', source 'megatron/training/arguments.py:3403', origin 'argparse'}
							use_distributed_optimizer {flag '--use-distributed-optimizer', default false, doc 'Use distributed optimizer.', source 'megatron/training/arguments.py:3407', origin 'argparse'}
							use_layer_wise_param_layout {flag '--no-use-layer-wise-param-layout', default true, doc 'Opt out of the precomputed LayerWise param layout. When set, falls back to the legacy LayerWise ping-pong path: all params (including non-Muon embeddings, biases, layernorm) live in a single LayerWise buffer and the optimizer uses the allgather_params() codepath. The default (precomputed layout) routes non-Muon params through a separate DistributedOptimizer with byte-level sharding, which is faster and uses less padding but produces different bf16 reduction ordering and so will not match legacy-path loss curves bit-for-bit.', source 'megatron/training/arguments.py:3411', origin 'argparse'}
							nccl_ub {flag '--use-nccl-ub', default false, doc 'Use the userbuffer registration for DP/FSDP communication buffers.This option will reduce GPU SM usage for the DP/FSDP communication,which is improving the performance of the overlapped computation.', source 'megatron/training/arguments.py:3422', origin 'argparse'}
							disable_symmetric_registration {flag '--disable-symmetric-registration', default false, doc 'Disable symmetric (window) registration for NCCL userbuffer registration.This option will force to use conventional (local) userbuffer registration when use-nccl-ub is set. Cannot be combined with --gtp-remat-nccl-ub/--gtp-expert-remat-nccl-ub, which require symmetric windows.', source 'megatron/training/arguments.py:3426', origin 'argparse'}
							gtp_remat_nccl_ub {flag '--gtp-remat-nccl-ub', default false, doc 'Register the wgrad reduce-scatter send buffers with NCCL symmetric memory on the GTP group, independent of --use-nccl-ub (which covers the DP group).', source 'megatron/training/arguments.py:3430', origin 'argparse'}
							gtp_expert_remat_nccl_ub {flag '--gtp-expert-remat-nccl-ub', default false, doc 'Like --gtp-remat-nccl-ub but for routed-expert (EGTP) groups.', source 'megatron/training/arguments.py:3433', origin 'argparse'}
							fsdp_manual_registration {flag '--fsdp-manual-registration', default false, doc 'Manually register the FSDP communication buffers to NCCL user buffer.This option is only effective when use-megatron-fsdp and use-nccl-ub is set.', source 'megatron/training/arguments.py:3435', origin 'argparse'}
							create_all_gather_group {flag '--create-all-gather-group', default false, doc 'Create a separate process group for all-gather operations to overlap reduce-scatter and all-gather operations.', source 'megatron/training/arguments.py:3438', origin 'argparse'}
							expert_data_parallel_sharding_strategy {flag '--expert-data-parallel-sharding-strategy', doc 'Sharding strategy of data parallelism for expert (MoE) parameters. When set, --data-parallel-sharding-strategy only applies to non-expert parameters. Expert parameters are sharded over a narrower DP group than non-expert parameters when expert parallelism is enabled, so the two classes can warrant different communication / memory trade-offs. Defaults to None, which applies --data-parallel-sharding-strategy to every parameter.', source 'megatron/training/arguments.py:3444', origin 'argparse'}
								alternative
									expert_data_parallel_sharding_strategy_no_shard {value 'no_shard'}
									expert_data_parallel_sharding_strategy_optim {value 'optim'}
									expert_data_parallel_sharding_strategy_optim_grads {value 'optim_grads'}
									expert_data_parallel_sharding_strategy_optim_grads_params {value 'optim_grads_params'}
							expert_outer_dp_sharding_strategy {flag '--expert-outer-dp-sharding-strategy', doc 'Sharding strategy for the outer expert data-parallel group in MFSDP v2. Valid values are "no_shard" (HSDP) and "optim" (HFSDP). Defaults to --outer-dp-sharding-strategy when omitted.', source 'megatron/training/arguments.py:3460', origin 'argparse'}
								alternative
									expert_outer_dp_sharding_strategy_no_shard {value 'no_shard'}
									expert_outer_dp_sharding_strategy_optim {value 'optim'}
							hfsdp_param_gather_overlap {flag '--hfsdp-param-gather-overlap', default false, doc 'Pipeline HFSDP parameter all-gathers across DP-Outer and DP-Inner. DP-Outer is prefetched one FSDP unit beyond the existing DP-Inner prefetch frontier. Only effective with --outer-dp-sharding-strategy=optim.', source 'megatron/training/arguments.py:3465', origin 'argparse'}
							gradient_reduce_div_fusion {flag '--no-gradient-reduce-div-fusion', default true, doc 'If not set, fuse the division in gradient reduce.', source 'megatron/training/arguments.py:3470', origin 'argparse'}
							fsdp_double_buffer {flag '--fsdp-double-buffer', default false, doc 'Enable double buffering for temporary memory needed for Megatron FSDP communications. Double-buffering the communication memory improves memory management efficiency by reusing previously allocated buffers, rather than creating new buffers for each FSDP communication. This is required for user buffer registration and is enabled by default when using NCCL user buffers.', source 'megatron/training/arguments.py:3472', origin 'argparse'}
							Integer suggested_communication_unit_size {flag '--suggested-communication-unit-size', doc 'Specifies the number of elements to communicate at once during FSDP (Fully Sharded Data Parallel) operations. This flag also affects FSDP all-gather prefetch behavior. Setting a larger value increases the communication buffer size, while a smaller value disables prefetching and may degrade performance. Adjust this value based on your system`s memory and performance requirements.', source 'megatron/training/arguments.py:3477', origin 'argparse'}
							keep_fp8_transpose_cache {flag '--keep-fp8-transpose-cache', default false, doc 'If set, keep the fp8 transpose cache when using Megatron FSDP.', source 'megatron/training/arguments.py:3482', origin 'argparse'}
							enable_full_sharding_in_hsdp {flag '--enable-full-sharding-in-hsdp', default false, doc 'If set, enable full sharding in megatron-fsdp Hybrid Sharded Data Parallel (HSDP) mode.', source 'megatron/training/arguments.py:3484', origin 'argparse'}
							torch_fsdp2_reshard_after_forward {flag '--torch-fsdp2-no-reshard-after-forward', default true, doc 'Whether to reshard weights after forward pass when using PyTorch FSDP2. Set to enable FSDP ZeRO-2.', source 'megatron/training/arguments.py:3488', origin 'argparse'}
							Integer max_seqlen_per_dp_cp_rank {flag '--max-seqlen-per-dp-cp-rank', doc 'Maximum sequence length per CP rank. This is used to calculate the number of sub-samples assigned to each CP rank when using heterogeneous context parallel.', source 'megatron/training/arguments.py:3497', origin 'argparse'}
							hybrid_context_parallel {flag '--hybrid-context-parallel', default false, doc 'Enables hybrid context parallel. This is used to balance the workload of each CP rank when we use packed samples with variable sequence lengths. Requires --max-seqlen-per-dp-cp-rank to be set.', source 'megatron/training/arguments.py:3500', origin 'argparse'}
							sequence_packing_scheduler {flag '--sequence-packing-scheduler', source 'megatron/training/arguments.py:3504', origin 'argparse'}
								alternative
									sequence_packing_scheduler_dp_balanced {value 'dp_balanced'}
							fake_process_group {flag '--fake-process-group', default false, doc 'If set, initialize with fake distributed process group and all distributed communication operations will be skipped. This is quite useful for profiling memory usage of distributed training with just one GPU. Setting WORLD_SIZE and RANK to the specific values for target distribtued scale.', source 'megatron/training/arguments.py:3505', origin 'argparse'}
					ValidationGroup {abstract, title 'validation', function '_add_validation_args', doc 'ValidationConfig: Configuration settings related to validation during or after model training.', parameters 10}
						mandatory
							Integer eval_iters {flag '--eval-iters', default 100, doc 'Number of iterations to run for evaluation. Used for both validation and test. If not set, evaluation will not run.', source 'megatron/training/config/training_config.py:115', origin 'dataclass ValidationConfig'}
						optional
							Integer eval_interval {flag '--eval-interval', doc 'Interval between running evaluation on validation set. If not set, evaluation will not run during training.', source 'megatron/training/config/training_config.py:119', origin 'dataclass ValidationConfig'}
							Integer start_eval_at_iter {flag '--start-eval-at-iter', doc 'If set, evaluation will only start after this iteration number. Useful for skipping evaluation during early training iterations when the model is not yet meaningful. If not set, evaluation starts from the first eval_interval.', source 'megatron/training/config/training_config.py:124', origin 'dataclass ValidationConfig'}
							Integer eval_global_batch_size {flag '--eval-global-batch-size', doc 'Global batch size to use during evaluation. If not set, defaults to global_batch_size. Must be divisible by (eval_micro_batch_size * data_parallel_size).', source 'megatron/training/config/training_config.py:130', origin 'dataclass ValidationConfig'}
							Integer eval_micro_batch_size {flag '--eval-micro-batch-size', doc 'Micro batch size to use during evaluation. If not set, defaults to micro_batch_size. Changing this affects per-device memory usage during eval and the number of microbatches per eval step.', source 'megatron/training/config/training_config.py:135', origin 'dataclass ValidationConfig'}
							skip_train {flag '--skip-train', default false, doc 'If set, bypass the training loop, perform evaluation for validation/test, and exit.', source 'megatron/training/config/training_config.py:141', origin 'dataclass ValidationConfig'}
							test_mode {flag '--test-mode', default false, doc 'Run all real-time test alongside the experiment.', source 'megatron/training/config/training_config.py:144', origin 'dataclass ValidationConfig'}
							full_validation {flag '--full-validation', default false, doc 'If set, each time validation occurs it uses the full validation dataset(s). This currently only works for GPT datasets!', source 'megatron/training/config/training_config.py:147', origin 'dataclass ValidationConfig'}
							multiple_validation_sets {flag '--multiple-validation-sets', default false, doc 'If set, multiple datasets listed in the validation split are evaluated independently with a separate loss for each dataset in the list. This argument requires that no weights are included in the list.', source 'megatron/training/config/training_config.py:150', origin 'dataclass ValidationConfig'}
							String validation_set_names {flag '--validation-set-names', doc 'Optional list of names for multiple validation sets. When provided with --multiple-validation-sets, these names are used instead of numeric indices (e.g. `validation-wiki` instead of `validation-0`). The number of names must match the number of validation datasets.', source 'megatron/training/config/training_config.py:156', origin 'dataclass ValidationConfig', nargs '+'}
					TokenizerGroup {abstract, title 'tokenizer', function '_add_tokenizer_args', doc 'TokenizerConfig: Configuration settings for the tokenizers.', parameters 21}
						mandatory
							Integer vocab_extra_ids {flag '--vocab-extra-ids', default 0, doc 'Number of additional vocabulary tokens. They are used for span masking in the T5 model.', source 'megatron/training/config/training_config.py:691', origin 'dataclass TokenizerConfig'}
							Integer tiktoken_num_special_tokens {flag '--tiktoken-num-special-tokens', default 1000, doc 'Number of special tokens in tiktoken tokenizer.', source 'megatron/training/config/training_config.py:726', origin 'dataclass TokenizerConfig'}
							Integer null_tokenizer_pad_id {flag '--null-tokenizer-pad-id', default -1, doc 'Pad token id for NullTokenizer. Defaults to -1 (no pad token). Set to a value outside the dataset to avoid masking real tokens.', source 'megatron/training/config/training_config.py:747', origin 'dataclass TokenizerConfig'}
						optional
							Integer vocab_size {flag '--vocab-size', doc 'Size of vocab before EOD or padding.', source 'megatron/training/config/training_config.py:675', origin 'dataclass TokenizerConfig'}
							Integer padded_vocab_size {flag '--padded-vocab-size', doc 'Vocabulary size of the model (padded to be divisible by tensor model parallel size). If not provided, it will be automatically calculated from vocab-size.', source 'megatron/training/config/training_config.py:678', origin 'dataclass TokenizerConfig'}
							pad_vocab_size {flag '--no-pad-vocab-size --disable-pad-vocab-size', default true, doc 'Whether to pad vocab size of the model automatically if padded_vocab_size is not provided.', source 'megatron/training/config/training_config.py:682', origin 'dataclass TokenizerConfig'}
							String vocab_file {flag '--vocab-file', doc 'Path to the vocab file.', source 'megatron/training/config/training_config.py:685', origin 'dataclass TokenizerConfig'}
							String merge_file {flag '--merge-file', doc 'Path to the BPE merge file.', source 'megatron/training/config/training_config.py:688', origin 'dataclass TokenizerConfig'}
							tokenizer_type {flag '--tokenizer-type', doc 'What type of tokenizer to use.', source 'megatron/training/config/training_config.py:694', origin 'dataclass TokenizerConfig'}
								alternative
									tokenizer_type_BertWordPieceLowerCase {value 'BertWordPieceLowerCase'}
									tokenizer_type_BertWordPieceCase {value 'BertWordPieceCase'}
									tokenizer_type_GPT2BPETokenizer {value 'GPT2BPETokenizer'}
									tokenizer_type_SentencePieceTokenizer {value 'SentencePieceTokenizer'}
									tokenizer_type_GPTSentencePieceTokenizer {value 'GPTSentencePieceTokenizer'}
									tokenizer_type_HuggingFaceTokenizer {value 'HuggingFaceTokenizer'}
									tokenizer_type_Llama2Tokenizer {value 'Llama2Tokenizer'}
									tokenizer_type_TikTokenizer {value 'TikTokenizer'}
									tokenizer_type_MultimodalTokenizer {value 'MultimodalTokenizer'}
									tokenizer_type_NullTokenizer {value 'NullTokenizer'}
									tokenizer_type_NullMultimodalTokenizer {value 'NullMultimodalTokenizer'}
									tokenizer_type_SFTTokenizer {value 'SFTTokenizer'}
							String tokenizer_model {flag '--tokenizer-model', doc 'Path to the tokenizer model.', source 'megatron/training/config/training_config.py:710', origin 'dataclass TokenizerConfig'}
							String metadata_path {flag '--tokenizer-metadata', doc 'Path to the tokenizer metadata file in json format.', source 'megatron/training/config/training_config.py:713', origin 'dataclass TokenizerConfig'}
							String special_tokens {flag '--tokenizer-special-tokens', doc 'List of special tokens. For TikTokenizer needs to have ["<unk>", "<s>", "</s>", "<mask>", "<pad>", "<cls>", "<sep>"]', source 'megatron/training/config/training_config.py:716', origin 'dataclass TokenizerConfig', nargs '+'}
							tiktoken_pattern {flag '--tiktoken-pattern', doc 'Which tiktoken pattern to use. Options: [v1, v2]', source 'megatron/training/config/training_config.py:720', origin 'dataclass TokenizerConfig'}
								alternative
									tiktoken_pattern_v1 {value 'v1'}
									tiktoken_pattern_v2 {value 'v2'}
							tokenizer_sentencepiece_legacy {flag '--tokenizer-sentencepiece-legacy', default false, doc 'SentencePiece tokenizer wrapper legacy behavior. Allows special tokens usage.', source 'megatron/training/config/training_config.py:729', origin 'dataclass TokenizerConfig'}
							tokenizer_sentencepiece_ignore_extra_whitespaces {flag '--no-tokenizer-sentencepiece-ignore-extra-whitespaces --disable-tokenizer-sentencepiece-ignore-extra-whitespaces', default true, doc 'Whether to ignore extra whitespaces in the input text while encoding.', source 'megatron/training/config/training_config.py:732', origin 'dataclass TokenizerConfig'}
							tokenizer_hf_no_use_fast {flag '--tokenizer-hf-no-use-fast', default false, doc 'Whether to use fast HuggingFace tokenizer.', source 'megatron/training/config/training_config.py:735', origin 'dataclass TokenizerConfig'}
							tokenizer_hf_no_include_special_tokens {flag '--tokenizer-hf-no-include-special-tokens', default false, doc 'Converting text to ids will not include special for HuggingFace tokenizer.', source 'megatron/training/config/training_config.py:738', origin 'dataclass TokenizerConfig'}
							trust_remote_code {flag '--trust-remote-code', default false, doc 'Whether or not to allow PreTrainedTokenizer to execute remote code.', source 'megatron/training/config/training_config.py:741', origin 'dataclass TokenizerConfig'}
							Integer null_tokenizer_eod_id {flag '--null-tokenizer-eod-id', doc 'EOD token id for NullTokenizer. Defaults to `vocab_size - 1`.', source 'megatron/training/config/training_config.py:744', origin 'dataclass TokenizerConfig'}
							String chat_template {flag '--chat-template', doc 'Custom chat template in jinja format for conversation formatting.', source 'megatron/training/config/training_config.py:751', origin 'dataclass TokenizerConfig'}
							use_gigatoken {flag '--use-gigatoken', default false, doc 'Whether to use faster implementation of tokenizers (gigatoken)', source 'megatron/training/config/training_config.py:754', origin 'dataclass TokenizerConfig'}
					DataAndDataloaderGroup {abstract, title 'data and dataloader', function '_add_data_args', parameters 41}
						mandatory
							Real sample_rate {flag '--sample-rate', default 1.0, doc 'sample rate for training data. Supposed to be 0 < sample_rate < 1', source 'megatron/training/arguments.py:3590', origin 'argparse'}
							Real mask_prob {flag '--mask-prob', default 0.15, doc 'Probability of replacing a token with mask.', source 'megatron/training/arguments.py:3593', origin 'argparse'}
							Real short_seq_prob {flag '--short-seq-prob', default 0.1, doc 'Probability of producing a short sequence.', source 'megatron/training/arguments.py:3595', origin 'argparse'}
							Integer num_workers {flag '--num-workers', default 2, doc 'Dataloader number of workers.', source 'megatron/training/arguments.py:3597', origin 'argparse'}
							Integer num_dataset_builder_threads {flag '--num-dataset-builder-threads', default 1, doc 'Number of parallel threads per rank for dataset builder', source 'megatron/training/arguments.py:3613', origin 'argparse'}
							Real mid_level_dataset_surplus {flag '--mid-level-dataset-surplus', default 0.005, doc 'The sample surplus to build for the mid-level datasets(s)', source 'megatron/training/arguments.py:3617', origin 'argparse'}
							Real fim_rate {flag '--fim-rate', default 0.5, doc 'Probability to convert a training sample into a FIM format.', source 'megatron/training/arguments.py:3634', origin 'argparse'}
							Real fim_spm_rate {flag '--fim-spm-rate', default 0.5, doc 'Probability that the a FIM sample uses the SPM format over the PSM format.', source 'megatron/training/arguments.py:3636', origin 'argparse'}
							String fim_prefix_token {flag '--fim-prefix-token', default '<fim_prefix>', doc 'FIM prefix token', source 'megatron/training/arguments.py:3644', origin 'argparse'}
							String fim_middle_token {flag '--fim-middle-token', default '<fim_middle>', doc 'FIM middle token', source 'megatron/training/arguments.py:3646', origin 'argparse'}
							String fim_suffix_token {flag '--fim-suffix-token', default '<fim_suffix>', doc 'FIM suffix token', source 'megatron/training/arguments.py:3648', origin 'argparse'}
							String fim_pad_token {flag '--fim-pad-token', default '<fim_pad>', doc 'FIM PAD token', source 'megatron/training/arguments.py:3650', origin 'argparse'}
							String fim_eod_token {flag '--fim-eod-token', default '<|endoftext|>', doc 'FIM EOD token', source 'megatron/training/arguments.py:3652', origin 'argparse'}
						optional
							String data_path {flag '--data-path', doc 'The weight and prefix list for a set of train, validation, and testdatasets which split according to --split. The accepted formats are: (1) a single prefix, (2) a list of weight prefix pairs e.g. weight1 prefix1 weight2 prefix2, (3) a list of prefixes e.g. prefix1 prefix2. For (3), weights are inferred from the lengths of the contributing datasets. This argument is exclusive to the other independent --*-data-path arguments.', source 'megatron/training/arguments.py:3533', origin 'argparse', nargs '*'}
							String phase_transition_iterations {flag '--phase-transition-iterations', doc 'Comma-separated list of iterations where phase transitions occur. Requires fixed global batch size across phases.', source 'megatron/training/arguments.py:3541', origin 'argparse'}
							String split {flag '--split', doc 'Comma-separated list of proportions for training, validation, and test split. For example the split `90,5,5` will use 90%% of data for training, 5%% for validation and 5%% for test.', source 'megatron/training/arguments.py:3544', origin 'argparse'}
							String train_data_path {flag '--train-data-path', doc 'The weight and prefix list for an independent train dataset. Follows the same pattern rules as --data-path.', source 'megatron/training/arguments.py:3549', origin 'argparse', nargs '*'}
							String valid_data_path {flag '--valid-data-path', doc 'The weight and prefix list for an independent validation dataset. Follows the same pattern rules as --data-path.', source 'megatron/training/arguments.py:3552', origin 'argparse', nargs '*'}
							String test_data_path {flag '--test-data-path', doc 'The weight and prefix list for an independent test dataset. Follows the same pattern rules as --data-path.', source 'megatron/training/arguments.py:3555', origin 'argparse', nargs '*'}
							String data_args_path {flag '--data-args-path', doc 'Path to data-args. Instead of feeding `--data-path` with weighted dataset, we pass in a file path from which we read that argument. This is useful when the list of data is too big.', source 'megatron/training/arguments.py:3558', origin 'argparse'}
							String per_split_data_args_path {flag '--per-split-data-args-path', doc 'Path to per-split-data-args. Instead of feeding `--(train|valid|test)-data-path` with weighted dataset, we pass in a file path from which we read those arguments. This is useful when the list of data is too big. Format is a json file with `train`, `valid, `test` keys', source 'megatron/training/arguments.py:3563', origin 'argparse'}
							String per_dataset_sequences_path {flag '--per-dataset-sequences-path', doc 'Path to a json file with the sequences per dataset. Check the tools/build_sequences_per_dataset.py script to build this file.', source 'megatron/training/arguments.py:3569', origin 'argparse'}
							dataloader_fast_cache_load {flag '--dataloader-fast-cache-load', default false, doc 'Option to use the fast cache loading path when building the datasets. Requires all the dataset caches to be built and stored in --data-cache-path.', source 'megatron/training/arguments.py:3571', origin 'argparse'}
							dataloader_defer_npy_index_mmap {flag '--dataloader-defer-npy-index-mmap', default false, doc 'Defer the mmap of the dataset indexes (.npy files) until the first access. Requires all the dataset caches to be built and stored in --data-cache-path.', source 'megatron/training/arguments.py:3573', origin 'argparse'}
							String data_cache_path {flag '--data-cache-path', doc 'Path to a directory to hold cached index files.', source 'megatron/training/arguments.py:3575', origin 'argparse'}
							mmap_bin_files {flag '--no-mmap-bin-files', default true, doc 'Disable mmap-ing of .bin files.', source 'megatron/training/arguments.py:3577', origin 'argparse'}
							mock_data {flag '--mock-data', default false, doc 'Skip data loading and validation and opt for artificial generation of mock data when an implementation is available.', source 'megatron/training/arguments.py:3580', origin 'argparse'}
							Integer seq_length {flag '--seq-length', doc 'Maximum sequence length to process.', source 'megatron/training/arguments.py:3583', origin 'argparse'}
							Integer encoder_seq_length {flag '--encoder-seq-length', doc 'Maximum encoder sequence length to process.This should be exclusive of --seq-length', source 'megatron/training/arguments.py:3585', origin 'argparse'}
							Integer decoder_seq_length {flag '--decoder-seq-length', doc 'Maximum decoder sequence length to process.', source 'megatron/training/arguments.py:3588', origin 'argparse'}
							reset_position_ids {flag '--reset-position-ids', default false, doc 'Reset posistion ids after end-of-document token.', source 'megatron/training/arguments.py:3599', origin 'argparse'}
							reset_attention_mask {flag '--reset-attention-mask', default false, doc 'Reset self attention mask after end-of-document token.', source 'megatron/training/arguments.py:3601', origin 'argparse'}
							dataloader_inter_document_masking {flag '--dataloader-inter-document-masking', default false, doc 'Return cu_seqlens marking document boundaries within each sample so that attention is restricted to individual documents.', source 'megatron/training/arguments.py:3604', origin 'argparse'}
							eod_mask_loss {flag '--eod-mask-loss', default false, doc 'Mask loss for the end of document tokens.', source 'megatron/training/arguments.py:3608', origin 'argparse'}
							create_attention_mask_in_dataloader {flag '--no-create-attention-mask-in-dataloader', default true, doc 'If set, do not create attention_masks in dataloader.', source 'megatron/training/arguments.py:3610', origin 'argparse'}
							String object_storage_cache_path {flag '--object-storage-cache-path', doc 'Path to cache index files when using s3 or msc dataloader', source 'megatron/training/arguments.py:3615', origin 'argparse'}
							allow_ambiguous_pad_tokens {flag '--allow-ambiguous-pad-tokens', default false, doc 'Whether to prevent pad tokens already present in the dataset from being masked out when the pad token incorrectly shares the same id with other special tokens in the tokenizer. Note that this argument has no effect when the tokenizer correctly provides a unique id for the pad. Masking out such ambiguous pad tokens results in training instability. Such a scenario is best resolved by fixing the tokenizer; leaving this option as False provides a workaround. When left to the default of False, any token ids that collide with the pad token id - as provided by the tokenizer - will not be masked out of the loss calculation: it cannot be determined whether they are truly pad. If instead this argument is set, the training flow will treat all tokens that share the same id as the pad token as true pad tokens, potentially causing severe training instability.', source 'megatron/training/arguments.py:3619', origin 'argparse'}
							fim_data {flag '--fim-data', default false, doc 'Whether to use the FIM dataset.', source 'megatron/training/arguments.py:3633', origin 'argparse'}
							String fim_split_sample {flag '--fim-split-sample', doc 'String around which to split the sample for FIM.', source 'megatron/training/arguments.py:3638', origin 'argparse'}
							Real fim_fragment_rate {flag '--fim-fragment-rate', doc 'Rate of FIM on each fragment when --fim-split-sample is not None.', source 'megatron/training/arguments.py:3640', origin 'argparse'}
							String fim_no_prefix {flag '--fim-no-prefix', doc 'Do not apply FIM to fragments that start with this prefix', source 'megatron/training/arguments.py:3642', origin 'argparse'}
					AutoresumeGroup {abstract, title 'autoresume', function '_add_autoresume_args', parameters 2}
						mandatory
