	// arguments.py:1064 torch FSDP2 requires untied embeddings/output weights
	use_torch_fsdp2 => untie_embeddings_and_output_weights
	// arguments.py:1066 torch FSDP2 not supported with fp16
	use_torch_fsdp2 => !fp16
	// arguments.py:1068 torch FSDP2 requires CUDA_DEVICE_MAX_CONNECTIONS != 1
	use_torch_fsdp2 => (!CUDA_DEVICE_MAX_CONNECTIONS | CUDA_DEVICE_MAX_CONNECTIONS != 1)
	// arguments.py:1087 --overlap-param-gather-with-optimizer-step requires distributed optimizer
	overlap_param_gather_with_optimizer_step => use_distributed_optimizer
	// arguments.py:1089 --overlap-param-gather-with-optimizer-step requires --overlap-param-gather
	overlap_param_gather_with_optimizer_step => overlap_param_gather
	// arguments.py:1091 --overlap-param-gather-with-optimizer-step requires interleaved PP (necessary condition: some VPP source must be given) v22: interleaving needs an effective VPP size != 1. arguments.py:957-990 derives it from --num-virtual-stages-per-pipeline-rank, or as ((num_layers + embedding + loss) / PP) / --num-layers-per-virtual-pipeline-stage, and sets VPP 1 to None (attempt 22 valid_0383, valid_0867: 4 layers, PP 2, 2 layers per virtual stage) v45: a pipeline layout or hybrid pattern interleaves only with more |-segments than PP (arguments.py:873-895, 952-959); UVL cannot count them, and the harness writes one segment per stage, so neither is a VPP source here (docs/uvl_limitations.md #4; held-out attempt 41 valid_1095, 1331, 1416, 1430, 1528).
	overlap_param_gather_with_optimizer_step => ((num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & ((!account_for_embedding_in_pipeline_split & !account_for_loss_in_pipeline_split & num_layers != pipeline_model_parallel_size * num_layers_per_virtual_pipeline_stage) | ((account_for_embedding_in_pipeline_split <=> !account_for_loss_in_pipeline_split) & num_layers + 1 != pipeline_model_parallel_size * num_layers_per_virtual_pipeline_stage) | (account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split & num_layers + 2 != pipeline_model_parallel_size * num_layers_per_virtual_pipeline_stage))) | (num_virtual_stages_per_pipeline_rank & num_virtual_stages_per_pipeline_rank != 1))
