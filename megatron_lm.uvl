							Integer wgrad_deferral_limit {flag '--wgrad-deferral-limit', default 0, doc 'This value tunes the number of micro-batches for which the embedding weight gradient compute needs to be deferred to pipeline flush, this argument is invalid if `defer_embedding_wgrad_compute` is False. Defaults to 0, which means all micro-batches are deferred.', source 'megatron/core/model_parallel_config.py:421', origin 'dataclass TransformerConfig'}
							Integer cpu_offloading_num_layers {flag '--cpu-offloading-num-layers', default 0, doc 'Tells the number of transformer layers for which activations has to be offloaded.', source 'megatron/core/model_parallel_config.py:467', origin 'dataclass TransformerConfig'}
							Real mtp_loss_scaling_factor {flag '--mtp-loss-scaling-factor', default 0.1, doc 'Weighting factor of Multi-Token Prediction (MTP) loss. We compute the average of the MTP losses across all depths, and multiply it the scaling factor to obtain the overall MTP loss, which serves as an additional training objective.', source 'megatron/core/transformer/transformer_config.py:82', origin 'dataclass TransformerConfig'}
							attention_backend {flag '--attention-backend', default 'auto', doc 'Attention backend to run. By default we let transformer engine decide the best backend to run (except in the case of local). If attention backend is local we use the local pytorch implementation in mcore. Users can specify exact backend by changing this config.', source 'megatron/core/transformer/transformer_config.py:165', origin 'dataclass TransformerConfig'}
