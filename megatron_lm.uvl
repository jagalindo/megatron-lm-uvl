	// transformer_config.py:2836-2848 the same with only the loss counted (VPP 1)
	(!pipeline_model_parallel_layout & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & (num_virtual_stages_per_pipeline_rank & num_virtual_stages_per_pipeline_rank == 1) & !account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 1 == aux_div_layers_pp * pipeline_model_parallel_size
	// transformer_config.py:2836-2848 the same with both counted (VPP 1)
	(!pipeline_model_parallel_layout & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & (num_virtual_stages_per_pipeline_rank & num_virtual_stages_per_pipeline_rank == 1) & account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 2 == aux_div_layers_pp * pipeline_model_parallel_size
	// transformer_config.py:2809-2814 uneven PP: the layers left for the middle stages must be divisible by the number of middle stages, whether or not VPP is set (constraints_v12_coverage.uvl adds the VPP factor when VPP != 1). Only first-stage layers given. Found while fixing attempt 31 valid_0693; docs/constraints_notes.md had listed it as a modulo check before divisibility used auxiliary integers
