							inprocess_granularity {flag '--inprocess-granularity', default 'node', doc 'Granularity for in-process restart.', source 'megatron/training/arguments.py:2718', origin 'argparse'}
								alternative
									inprocess_granularity_node {value 'node'}
									inprocess_granularity_rank {value 'rank'}
							Integer inprocess_active_world_size {flag '--inprocess-active-world-size', default 'int(os.getenv(`WORLD_SIZE`, `1`))', doc 'The number of ranks initially executing the workload. The remaining ranks from the allocation are set aside as warm reserve.', source 'megatron/training/arguments.py:2721', origin 'argparse'}
						optional
							inprocess_restart {flag '--inprocess-restart', default false, doc 'Enables in-process restart.', source 'megatron/training/arguments.py:2684', origin 'argparse'}
