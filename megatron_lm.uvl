	num_layers_per_virtual_pipeline_stage => (!decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers)
	// arguments.py:1009 interleaved schedule with p2p overlap requires PP > 1 (only VPP given directly via --num-virtual-stages-per-pipeline-rank)
	(num_virtual_stages_per_pipeline_rank & num_virtual_stages_per_pipeline_rank != 1 & overlap_p2p_comm) => pipeline_model_parallel_size > 1
	// arguments.py:1013 interleaved schedule without p2p overlap requires PP > 2 (only VPP given directly via --num-virtual-stages-per-pipeline-rank)
	(num_virtual_stages_per_pipeline_rank & num_virtual_stages_per_pipeline_rank != 1 & !overlap_p2p_comm) => pipeline_model_parallel_size > 2
	// arguments.py:1032 --overlap-param-gather requires distributed optimizer, megatron fsdp or dist_muon
	overlap_param_gather => (use_distributed_optimizer | use_megatron_fsdp | optimizer_dist_muon)
