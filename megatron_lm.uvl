	moe_layer_recompute => !recompute_granularity_full
	// transformer_config.py:2443-2445 'mhc' recompute requires --enable-mhc-connections
	((recompute_granularity_selective | recompute_activations | moe_layer_recompute) & recompute_modules_mhc) => enable_mhc_connections
	// transformer_config.py:2446-2450 'mhc' and 'mlp' recompute cannot be combined
