							mask_type {flag '--mask-type', default 'random', doc 'mask types', source 'megatron/training/arguments.py:3706', origin 'argparse'}
								alternative
									mask_type_random {value 'random'}
									mask_type_row {value 'row'}
							Real mask_factor {flag '--mask-factor', default 1.0, doc 'mask size scaling parameter', source 'megatron/training/arguments.py:3709', origin 'argparse'}
							Integer iter_per_epoch {flag '--iter-per-epoch', default 1250, doc 'iterations per epoch', source 'megatron/training/arguments.py:3713', origin 'argparse'}
