	((train_samples & train_samples != 0) & !skip_train) => !train_iters
	// arguments.py:1314 sample-based training excludes --lr-decay-iters
	((train_samples & train_samples != 0) & !skip_train) => !lr_decay_iters
	// arguments.py:1316 sample-based training requires lr_warmup_iters == 0
	((train_samples & train_samples != 0) & !skip_train) => lr_warmup_iters == 0
