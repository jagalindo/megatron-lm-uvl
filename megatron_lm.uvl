	!(hybrid_override_pattern & hybrid_layer_pattern)
	// arguments.py:847 --num-layers-per-virtual-pipeline-stage not allowed with hybrid layer pattern
	(hybrid_layer_pattern | hybrid_override_pattern | (mtp_hybrid_override_pattern & mtp_num_layers & mtp_num_layers > 0)) => !num_layers_per_virtual_pipeline_stage
	// arguments.py:853 --num-virtual-stages-per-pipeline-rank not allowed with hybrid layer pattern
	(hybrid_layer_pattern | hybrid_override_pattern | (mtp_hybrid_override_pattern & mtp_num_layers & mtp_num_layers > 0)) => !num_virtual_stages_per_pipeline_rank
	// arguments.py:858 --pipeline-model-parallel-layout not allowed with hybrid layer pattern
	(hybrid_layer_pattern | hybrid_override_pattern | (mtp_hybrid_override_pattern & mtp_num_layers & mtp_num_layers > 0)) => !pipeline_model_parallel_layout
	// arguments.py:862 --account-for-embedding-in-pipeline-split not allowed with hybrid layer pattern
	(hybrid_layer_pattern | hybrid_override_pattern | (mtp_hybrid_override_pattern & mtp_num_layers & mtp_num_layers > 0)) => !account_for_embedding_in_pipeline_split
	// arguments.py:867 --account-for-loss-in-pipeline-split not allowed with hybrid layer pattern
	(hybrid_layer_pattern | hybrid_override_pattern | (mtp_hybrid_override_pattern & mtp_num_layers & mtp_num_layers > 0)) => !account_for_loss_in_pipeline_split
	// arguments.py:916 MTP only supported with rope or none position embeddings (stricter than arguments.py:2059; mtp_num_layers may also be inferred from the hybrid pattern). v45 rev 14: the check is `if args.mtp_num_layers:`, so a negative count is MTP too (the bound probe: -1 failed here)
	(mtp_num_layers & mtp_num_layers != 0) => (position_embedding_type_rope | position_embedding_type_none)
	// arguments.py:922 --freeze-base-model-for-mtp cannot be combined with --freeze-all-layers
	freeze_base_model_for_mtp => !freeze_all_layers
