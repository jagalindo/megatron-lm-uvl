constraints
	// argparse mutually-exclusive group (arguments.py:3999)
	!(kitchen_config_file & kitchen_recipe_number)
	// ===== megatron/training/arguments.py : validate_args =====
	// arguments.py:419 checkpoint conversion requires --ckpt-convert-save
	ckpt_convert_format => ckpt_convert_save
	// arguments.py:420 checkpoint conversion requires --load
	ckpt_convert_format => load
	// arguments.py:424 only global/local non-persistent checkpoints supported
	!non_persistent_ckpt_type_in_memory
	// arguments.py:463 --attention-backend local only supported with --spec local (spec is a list; approximated as spec[0]=='local')
	attention_backend_local => spec == 'local'
	// arguments.py:477 --refit-execution-batch-bytes must be positive
	refit_execution_batch_bytes => refit_execution_batch_bytes > 0
	// arguments.py:482 nccl_m2n refit unsupported by built-in RL loop
	perform_rl_step => !refit_method_nccl_m2n
