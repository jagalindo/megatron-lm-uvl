	entry_point_pretrain_vlm => aux_vlm_tok == aux_vlm_ph * aux_vlm_pw + 1
	// [aux-def] TE 2.19 (pytorch/utils.py:614-624, quantizer.cpp:1514 and 1982, cublaslt_gemm.cu:769) the rows a quantized TE GEMM takes (its input's leading dimensions, which are also the reduction dimension of the weight-gradient GEMM) must be a multiple of 8 for FP8 with the delayed or tensorwise recipe (and the generic check for custom recipes), 16 for blockwise FP8 (fewer: "Unable to find suitable cuBLAS GEMM algorithm"), 32 for MXFP8 ("MXFP8 requires tensor dims that are divisible by 32") and 32 for NVFP4 (16 fails in the backward GEMM). Probed on pretrain_vlm with 197 image tokens x micro-batch 8, 16, 32, 64 and 128 (results/v45_rldbg run3-run6)
	(entry_point_pretrain_vlm & fp8 & !fp8_recipe_mxfp8 & !fp8_recipe_blockwise) => aux_vlm_q == 8
	// [aux-def] the same for blockwise FP8
	(entry_point_pretrain_vlm & fp8 & fp8_recipe_blockwise) => aux_vlm_q == 16
	// [aux-def] the same for MXFP8
	(entry_point_pretrain_vlm & fp8 & fp8_recipe_mxfp8) => aux_vlm_q == 32
	// [aux-def] the same for NVFP4 (the default FP4 recipe)
	(entry_point_pretrain_vlm & fp4 & !fp4_recipe_custom) => aux_vlm_q == 32
	// [aux-def] the same for a custom FP4 recipe: only the generic check is known
	(entry_point_pretrain_vlm & fp4 & fp4_recipe_custom) => aux_vlm_q == 8
	// transformer_engine.py:1706 (+ TE 2.19 pytorch/utils.py:614-624, quantizer.cpp:1514 and 1982) with FP8 or FP4 the vision encoder's and projector's TE layers take image tokens x micro-batch rows, which must be a multiple of the recipe's quantum (aux_vlm_q): 197 x 2 = 394 at the default 224-pixel image fails "FP8 execution requires the product of all dimensions except the last to be divisible by 8" (held-out s3_valid_1012 FP4, s3_valid_1018 FP8, s3_valid_1025 MXFP8). At runtime
	(entry_point_pretrain_vlm & (fp8 | fp4) & ((!skip_train & ((train_iters & train_iters != 0) | (train_samples & train_samples != 0))) | full_validation | eval_iters > 0)) => aux_vlm_tok * micro_batch_size == aux_div_vlm_fp8_enc * aux_vlm_q
	// [aux-def] context_parallel.py:57-68 (+ pretrain_vlm.py:102-112) the language model's sequence (text + image tokens) is padded to a multiple of TP x CP x 2 with sequence and context parallelism, of CP x 2 with context parallelism, of TP with sequence parallelism (which validate_args turns off at TP 1, arguments.py:1452-1458), and not at all otherwise
	(entry_point_pretrain_vlm & context_parallel_size > 1 & sequence_parallel & tensor_model_parallel_size > 1) => aux_vlm_pad_f == tensor_model_parallel_size * context_parallel_size * 2
	// [aux-def] context_parallel.py:61-62 the same with context parallelism only
	(entry_point_pretrain_vlm & context_parallel_size > 1 & !(sequence_parallel & tensor_model_parallel_size > 1)) => aux_vlm_pad_f == context_parallel_size * 2
	// [aux-def] context_parallel.py:63-64 the same with sequence parallelism only
	(entry_point_pretrain_vlm & !(context_parallel_size > 1) & sequence_parallel & tensor_model_parallel_size > 1) => aux_vlm_pad_f == tensor_model_parallel_size
	// [aux-def] context_parallel.py:57 the same without either: no padding (pretrain_vlm does not ask for FP8 padding)
	(entry_point_pretrain_vlm & !(context_parallel_size > 1) & !(sequence_parallel & tensor_model_parallel_size > 1)) => aux_vlm_pad_f == 1
	// [aux-def] context_parallel.py:68 the padded sequence in units of the padding: the ceiling of (text + image tokens) / padding
	entry_point_pretrain_vlm => (aux_vlm_dec_k * aux_vlm_pad_f >= seq_length + aux_vlm_tok & aux_vlm_dec_k * aux_vlm_pad_f < seq_length + aux_vlm_tok + aux_vlm_pad_f)
	// [aux-def] each rank's share of the padded sequence is padded / (TP with sequence parallelism) / CP, which is 2 x aux_vlm_dec_k units with context parallelism and aux_vlm_dec_k without
	(entry_point_pretrain_vlm & context_parallel_size > 1) => aux_vlm_pad_r == 2
	// [aux-def] the same without context parallelism
	(entry_point_pretrain_vlm & !(context_parallel_size > 1)) => aux_vlm_pad_r == 1
	// transformer_engine.py:1706 (+ TE 2.19 pytorch/utils.py:614-624, quantizer.cpp:1514 and 1982) the same FP8/FP4 rule for the language model's TE layers, which take each rank's share of the padded text + image sequence x micro-batch rows. At runtime
	(entry_point_pretrain_vlm & (fp8 | fp4) & ((!skip_train & ((train_iters & train_iters != 0) | (train_samples & train_samples != 0))) | full_validation | eval_iters > 0)) => aux_vlm_pad_r * aux_vlm_dec_k * micro_batch_size == aux_div_vlm_fp8_dec * aux_vlm_q
	// pretrain_vlm.py:200-202 (+ llava_model.py:526, multimodal_projector.py:49, mlp.py:221) pretrain_vlm builds its vision projection from the language layer spec's MLP submodules; with --num-experts that spec is a MoE layer, whose submodules have no linear_fc1: "'MoESubmodules' object has no attribute 'linear_fc1'" (s3_valid_1028). With --spec the layer spec is the user's. At runtime
	!(entry_point_pretrain_vlm & !spec & (num_experts & num_experts != 0))
	// training_config.py:666-668 (+ argument_utils.py:708; pretrain_gpt.py:580, pretrain_hybrid.py:569, pretrain_vlm.py:502, train_rl.py:426) every entry script builds its checkpoint configuration right after parsing, and --verify-integrity needs the torch_dist format: "`verify_integrity` is only supported with torch_dist checkpoint format" (s3_valid_1016: pretrain_vlm needs --ckpt-format torch, so it can never verify). At runtime
	((entry_point_pretrain_gpt | entry_point_pretrain_hybrid | entry_point_pretrain_vlm | entry_point_train_rl) & verify_integrity) => ckpt_format_torch_dist
	// clip_vit_model.py:124 (+ training.py:2616-2626, pretrain_vlm.py:209, llava_model.py:334) the CLIP encoder copies its position ids to the GPU while it is built (torch.arange(...).cuda()), which fails under --init-model-with-meta-device: "Cannot copy out of meta tensor; no data!" (v45 dry run 2 s3_valid_6126). At runtime
	!(entry_point_pretrain_vlm & init_model_with_meta_device)
	// llava_model.py:221-238 (+ pretrain_vlm.py:135-144) with sequence or context parallelism in the language model LLaVA needs Transformer Engine's DotProductAttention in its layers, and pretrain_vlm builds them with TE only for --transformer-impl transformer_engine: "Sequence/Context Parallelism is supported only with TE DotProductAttention." (v45 dry run 3 s3_valid_6419: CP 2, --transformer-impl local). At runtime
	!(entry_point_pretrain_vlm & !spec & ((sequence_parallel & tensor_model_parallel_size > 1) | context_parallel_size > 1) & !transformer_impl_transformer_engine)
	// [intent] pretrain_vlm.py:135-136 (+ spec_utils.py:47) pretrain_vlm imports --spec as a (module, function) pair. The only value our harness can give, 'local', is one token ("not enough values to unpack (expected 2, got 1)", v45 dry run 3 s3_valid_6422), and UVL cannot see what the string names (docs/uvl_limitations.md #4), so the model keeps --spec out of pretrain_vlm
	!(entry_point_pretrain_vlm & spec)
	// ===== v6: divisibility rules, encoded with auxiliary integers (x divisible by y <=> x == aux * y; constraints tagged [aux-def] only define the helpers and are not Megatron rules; aux_* features are declared by scripts/gen_uvl.py, see docs/constraints_notes.md correction) =====
	// arguments.py:450-458 tensor_model_parallel_size is a divisor of the world size: must be >= 1
	tensor_model_parallel_size >= 1
	// arguments.py:450-458 context_parallel_size is a divisor of the world size: must be >= 1
	context_parallel_size >= 1
	// [aux-def] auxiliary multiplier aux_gtp_weight_remat_size is a positive integer
	aux_gtp_weight_remat_size >= 1
	// [aux-def] auxiliary multiplier aux_data_parallel_size is a positive integer
	aux_data_parallel_size >= 1
	// [aux-def] auxiliary multiplier aux_div_expert_shards is a positive integer
	aux_div_expert_shards >= 1
	// [aux-def] auxiliary multiplier aux_div_gbs is a positive integer
	aux_div_gbs >= 1
	// [aux-def] auxiliary multiplier aux_div_eval is a positive integer
	aux_div_eval >= 1
	// [aux-def] auxiliary multiplier aux_div_layers_pp is a positive integer
	aux_div_layers_pp >= 1
	// [aux-def] auxiliary multiplier aux_div_vpp is a positive integer
	aux_div_vpp >= 1
	// [aux-def] auxiliary multiplier aux_div_head_dim is a positive integer
	aux_div_head_dim >= 1
	// [aux-def] auxiliary multiplier aux_div_seq_cp is a positive integer
	aux_div_seq_cp >= 1
	// [aux-def] auxiliary multiplier aux_div_heads_tp is a positive integer
	aux_div_heads_tp >= 1
	// [aux-def] auxiliary multiplier aux_div_heads_qg is a positive integer
	aux_div_heads_qg >= 1
	// [aux-def] auxiliary multiplier aux_div_qg_tp is a positive integer
	aux_div_qg_tp >= 1
	// [aux-def] auxiliary multiplier aux_div_tp_qg is a positive integer
	aux_div_tp_qg >= 1
	// [aux-def] auxiliary multiplier aux_div_experts_ep is a positive integer
	aux_div_experts_ep >= 1
	// [aux-def] auxiliary multiplier aux_div_experts_groups is a positive integer
	aux_div_experts_groups >= 1
	// [aux-def] auxiliary multiplier aux_div_retain is a positive integer
	aux_div_retain >= 1
	// [aux-def] auxiliary multiplier aux_div_log_memory is a positive integer
	aux_div_log_memory >= 1
	// arguments.py:443-448 + model_parallel_config.py:30-37 resolve_tensor_parallel_weight_shards: gtp_weight_remat_size = shards // tp, shards divisible by tp
	tensor_parallel_num_weight_shards => tensor_parallel_num_weight_shards == aux_gtp_weight_remat_size * tensor_model_parallel_size
	// [aux-def] model_parallel_config.py resolve_tensor_parallel_weight_shards: without --tensor-parallel-num-weight-shards, gtp_weight_remat_size = 1
	!tensor_parallel_num_weight_shards => aux_gtp_weight_remat_size == 1
	// arguments.py:450-460 world_size % (tp * pp * cp * gtp) == 0; the quotient is data_parallel_size (Experiment 2 mut_119-125)
	WORLD_SIZE == aux_data_parallel_size * tensor_model_parallel_size * pipeline_model_parallel_size * context_parallel_size * aux_gtp_weight_remat_size
	// model_parallel_config.py:30-37 resolve_tensor_parallel_weight_shards (expert): expert shards divisible by expert TP (expert_tensor_parallel_size, defaults to TP)
	(expert_tensor_parallel_num_weight_shards & expert_tensor_parallel_size) => expert_tensor_parallel_num_weight_shards == aux_div_expert_shards * expert_tensor_parallel_size
	// model_parallel_config.py:30-37 resolve_tensor_parallel_weight_shards (expert), expert TP defaulting to TP
	(expert_tensor_parallel_num_weight_shards & !expert_tensor_parallel_size) => expert_tensor_parallel_num_weight_shards == aux_div_expert_shards * tensor_model_parallel_size
	// num_microbatches_calculator.py:381 (initialised in global_vars.py:176 with dp * gtp) global batch divisible by micro * dp * gtp, unless batch rampup / schedule / decrease-if-needed
	(global_batch_size & !rampup_batch_size & !step_batch_size_schedule & !decrease_batch_size_if_needed) => global_batch_size == aux_div_gbs * micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [set, eval_micro_batch_size]
	(eval_global_batch_size & eval_micro_batch_size) => eval_global_batch_size == aux_div_eval * eval_micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [set, !eval_micro_batch_size]
	(eval_global_batch_size & !eval_micro_batch_size) => eval_global_batch_size == aux_div_eval * micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [gbs, eval_micro_batch_size]
	(!eval_global_batch_size & global_batch_size & eval_micro_batch_size) => global_batch_size == aux_div_eval * eval_micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [gbs, !eval_micro_batch_size]
	(!eval_global_batch_size & global_batch_size & !eval_micro_batch_size) => global_batch_size == aux_div_eval * micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [none, eval_micro_batch_size]
	(!eval_global_batch_size & !global_batch_size & eval_micro_batch_size) => micro_batch_size * aux_data_parallel_size == aux_div_eval * eval_micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:741-752 eval_global_batch_size (defaults to global batch, itself micro*dp) divisible by eval_micro_batch_size (defaults to micro) * dp * gtp [none, !eval_micro_batch_size]
	(!eval_global_batch_size & !global_batch_size & !eval_micro_batch_size) => micro_batch_size * aux_data_parallel_size == aux_div_eval * micro_batch_size * aux_data_parallel_size * aux_gtp_weight_remat_size
	// arguments.py:988-1005 without VPP / uneven PP / hybrid pattern: (num_layers + embedding + loss) % PP == 0 [offset 0]
	(!pipeline_model_parallel_layout & !num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & !hybrid_layer_pattern & !account_for_embedding_in_pipeline_split & !account_for_loss_in_pipeline_split) => num_layers == aux_div_layers_pp * pipeline_model_parallel_size
	// arguments.py:960-981 VPP from --num-layers-per-virtual-pipeline-stage: (num_layers + embedding + loss) % PP == 0 and layers-per-stage % layers-per-VPP-stage == 0; VPP = aux_div_vpp [offset 0] (Experiment 2 valid_0046)
	(!pipeline_model_parallel_layout & num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !account_for_embedding_in_pipeline_split & !account_for_loss_in_pipeline_split) => num_layers == aux_div_vpp * num_layers_per_virtual_pipeline_stage * pipeline_model_parallel_size
	// arguments.py:988-1005 without VPP / uneven PP / hybrid pattern: (num_layers + embedding + loss) % PP == 0 [offset 1]
	(!pipeline_model_parallel_layout & !num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & !hybrid_layer_pattern & !account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 1 == aux_div_layers_pp * pipeline_model_parallel_size
	// arguments.py:960-981 VPP from --num-layers-per-virtual-pipeline-stage: (num_layers + embedding + loss) % PP == 0 and layers-per-stage % layers-per-VPP-stage == 0; VPP = aux_div_vpp [offset 1] (Experiment 2 valid_0046)
	(!pipeline_model_parallel_layout & num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 1 == aux_div_vpp * num_layers_per_virtual_pipeline_stage * pipeline_model_parallel_size
	// arguments.py:988-1005 without VPP / uneven PP / hybrid pattern: (num_layers + embedding + loss) % PP == 0 [offset 1]
	(!pipeline_model_parallel_layout & !num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & !hybrid_layer_pattern & account_for_embedding_in_pipeline_split & !account_for_loss_in_pipeline_split) => num_layers + 1 == aux_div_layers_pp * pipeline_model_parallel_size
	// arguments.py:960-981 VPP from --num-layers-per-virtual-pipeline-stage: (num_layers + embedding + loss) % PP == 0 and layers-per-stage % layers-per-VPP-stage == 0; VPP = aux_div_vpp [offset 1] (Experiment 2 valid_0046)
	(!pipeline_model_parallel_layout & num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & account_for_embedding_in_pipeline_split & !account_for_loss_in_pipeline_split) => num_layers + 1 == aux_div_vpp * num_layers_per_virtual_pipeline_stage * pipeline_model_parallel_size
	// arguments.py:988-1005 without VPP / uneven PP / hybrid pattern: (num_layers + embedding + loss) % PP == 0 [offset 2]
	(!pipeline_model_parallel_layout & !num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & !decoder_first_pipeline_num_layers & !decoder_last_pipeline_num_layers & !hybrid_layer_pattern & account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 2 == aux_div_layers_pp * pipeline_model_parallel_size
	// arguments.py:960-981 VPP from --num-layers-per-virtual-pipeline-stage: (num_layers + embedding + loss) % PP == 0 and layers-per-stage % layers-per-VPP-stage == 0; VPP = aux_div_vpp [offset 2] (Experiment 2 valid_0046)
	(!pipeline_model_parallel_layout & num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & account_for_embedding_in_pipeline_split & account_for_loss_in_pipeline_split) => num_layers + 2 == aux_div_vpp * num_layers_per_virtual_pipeline_stage * pipeline_model_parallel_size
	// arguments.py:984-1016 interleaved schedule (derived VPP > 1) needs PP > 1 with p2p overlap, PP > 2 without (Experiment 2 mut_059-062)
	(!pipeline_model_parallel_layout & num_layers_per_virtual_pipeline_stage & !num_virtual_stages_per_pipeline_rank & aux_div_vpp > 1) => ((overlap_p2p_comm => pipeline_model_parallel_size > 1) & (!overlap_p2p_comm => pipeline_model_parallel_size > 2))
	// arguments.py:1350-1351 without --kv-channels, hidden_size % num_attention_heads == 0
	!kv_channels => hidden_size == aux_div_head_dim * num_attention_heads
	// arguments.py:1354-1357 seq_length % (2 * cp) == 0 when cp > 1
	(seq_length & context_parallel_size > 1) => seq_length == aux_div_seq_cp * 2 * context_parallel_size
	// transformer_config.py:1728 num_attention_heads % tensor_model_parallel_size == 0
	num_attention_heads == aux_div_heads_tp * tensor_model_parallel_size
	// transformer_config.py:1742-1746 + argument_utils.py:383-386 (num_query_groups only used with --group-query-attention) num_query_groups divides num_attention_heads
	(group_query_attention & num_query_groups & num_query_groups > 0) => num_attention_heads == aux_div_heads_qg * num_query_groups
	// transformer_config.py:1748-1752 num_query_groups is a multiple or a divisor of TP
	(group_query_attention & num_query_groups) => (num_query_groups == aux_div_qg_tp * tensor_model_parallel_size | tensor_model_parallel_size == aux_div_tp_qg * num_query_groups)
	// arguments.py:1691-1694 num_experts % expert_model_parallel_size == 0 when EP > 1
	expert_model_parallel_size > 1 => ((num_experts & num_experts != 0) & num_experts == aux_div_experts_ep * expert_model_parallel_size)
	// transformer_config.py:3220-3224 group-limited routing: num_moe_experts % moe_router_num_groups == 0 (Experiment 2 valid_0120)
	(moe_router_group_topk & moe_router_group_topk != 0 & moe_router_num_groups & moe_router_num_groups != 0 & (num_experts & num_experts != 0)) => num_experts == aux_div_experts_groups * moe_router_num_groups
	// arguments.py:1383-1385 save_retain_interval % save_interval == 0
	(save & save_retain_interval) => save_retain_interval == aux_div_retain * save_interval
	// arguments.py:1388-1389 log_memory_interval % log_interval == 0; v45 rev 9: with --log-interval 0 the modulo itself raises ZeroDivisionError (v45 dry run 6 valid_7503), so the interval must not be 0 either (written as two inequalities inside this rule: as a rule of its own, or with !=, it made the train_rl baseline solve time out)
	log_memory_interval => (log_memory_interval == aux_div_log_memory * log_interval & (log_interval >= 1 | log_interval <= -1))
	// ===== v6: list membership. recompute_modules / offload_modules / cuda_graph_modules / cuda_graph_scope_deprecated are or-groups of their allowed values (scripts/gen_uvl.py LIST_CHOICES). Effective recompute membership: unset recompute_modules -> ['core_attn'] (transformer_config.py:2364), --moe-layer-recompute appends 'moe' and forces selective (:2433-2440). =====
	// transformer_config.py:2372-2375 moe_act recompute requires --moe-grouped-gemm. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & recompute_modules_moe_act) => moe_grouped_gemm
	// transformer_config.py:2376-2380 mla_up_proj recompute requires multi-latent attention. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & recompute_modules_mla_up_proj) => multi_latent_attention
	// transformer_config.py:2381-2388 gdn_norm_out recompute requires a gated-delta-net attention variant. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & recompute_modules_gdn_norm_out) => (experimental_attention_variant_gdn | experimental_attention_variant_gdn2 | experimental_attention_variant_gated_delta_net)
	// transformer_config.py:2396-2403 shared_experts recompute cannot work with --moe-shared-expert-overlap. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & recompute_modules_shared_experts & moe_shared_expert_intermediate_size) => !moe_shared_expert_overlap
	// transformer_config.py:2404-2416 fp8 with moe_act / layernorm / shortcut_pre_mlp_layernorm recompute: not with delayed scaling. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & fp8 & (recompute_modules_moe_act | recompute_modules_layernorm | recompute_modules_shortcut_pre_mlp_layernorm)) => !fp8_recipe_delayed
	// transformer_config.py:2417-2422 fp8 with moe_act / layernorm / shortcut_pre_mlp_layernorm recompute needs TE >= 2.6. v7: --moe-layer-recompute is not yet applied here (it forces selective later, at :2433-2440) (Experiment 2 attempt 6 mut_460/462/463)
	((recompute_granularity_selective | recompute_activations) & fp8 & (recompute_modules_moe_act | recompute_modules_layernorm | recompute_modules_shortcut_pre_mlp_layernorm)) => platform_te_version >= 206
