									cuda_graph_impl_full_iteration {value 'full_iteration'}
							Integer mhc_num_residual_streams {flag '--mhc-num-residual-streams', default 4, doc 'Number of residual streams (n in paper).', source 'megatron/core/transformer/transformer_config.py:1256', origin 'dataclass TransformerConfig'}
							Integer mhc_sinkhorn_iterations {flag '--mhc-sinkhorn-iterations', default 20, doc 'Number of Sinkhorn-Knopp iterations for doubly stochastic projection.', source 'megatron/core/transformer/transformer_config.py:1259', origin 'dataclass TransformerConfig'}
							Real mhc_init_gating_factor {flag '--mhc-init-gating-factor', default 0.01, doc 'Initial value of Gating Factor (alpha in paper).', source 'megatron/core/transformer/transformer_config.py:1262', origin 'dataclass TransformerConfig'}
							mhc_fused_backend {flag '--mhc-fused-backend', default 'auto', doc 'Backend policy for fused mHC operations. ``auto`` selects the fastest available implementation for each operation. Explicit policies require the requested dependency and device support, and never select a different accelerated backend. Operations without an implementation in the selected backend retain their native implementation.', source 'megatron/core/transformer/transformer_config.py:1273', origin 'dataclass TransformerConfig'}
