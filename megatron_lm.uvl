	// arguments.py:1274 local CUDA graphs require num_cuda_graphs > 0 or == -1 (enable_cuda_graph maps to local)
	(cuda_graph_impl_local | enable_cuda_graph) => (inference_dynamic_batching_num_cuda_graphs > 0 | inference_dynamic_batching_num_cuda_graphs == -1)
