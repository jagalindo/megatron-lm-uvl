									timing_log_level_2 {value 2}
							timing_log_option {flag '--timing-log-option', default 'minmax', doc 'Options for logging timing: max: report the max timing across all ranks minmax: report min and max timings across all ranks all: report timings of all ranks.', source 'megatron/training/config/training_config.py:276', origin 'dataclass LoggerConfig'}
								alternative
									timing_log_option_max {value 'max'}
									timing_log_option_minmax {value 'minmax'}
									timing_log_option_all {value 'all'}
							Integer tensorboard_log_interval {flag '--tensorboard-log-interval', default 1, doc 'Report to tensorboard interval.', source 'megatron/training/config/training_config.py:286', origin 'dataclass LoggerConfig'}
							Integer tensorboard_queue_size {flag '--tensorboard-queue-size', default 1000, doc 'Size of the tensorboard queue for pending events and summaries before one of the `add` calls forces a flush to disk.', source 'megatron/training/config/training_config.py:289', origin 'dataclass LoggerConfig'}
						optional
							log_params_norm {flag '--log-params-norm', default false, doc 'If set, calculate and log parameters norm.', source 'megatron/training/config/training_config.py:250', origin 'dataclass LoggerConfig'}
							log_throughput {flag '--log-throughput', default false, doc 'If set, calculate and log throughput per GPU.', source 'megatron/training/config/training_config.py:253', origin 'dataclass LoggerConfig'}
							log_progress {flag '--log-progress', default false, doc 'If set, log progress (in terms of number of processed tokens and number of floating-point operations) to progress.txt file in checkpoint directory.', source 'megatron/training/config/training_config.py:262', origin 'dataclass LoggerConfig'}
							String tensorboard_dir {flag '--tensorboard-dir', doc 'Write TensorBoard logs to this directory.', source 'megatron/training/config/training_config.py:283', origin 'dataclass LoggerConfig'}
							log_timers_to_tensorboard {flag '--log-timers-to-tensorboard', default false, doc 'If set, write timers to tensorboard.', source 'megatron/training/config/training_config.py:294', origin 'dataclass LoggerConfig'}
							log_loss_scale_to_tensorboard {flag '--no-log-loss-scale-to-tensorboard --disable-log-loss-scale-to-tensorboard', default true, doc 'Disable loss-scale logging to tensorboard.', source 'megatron/training/config/training_config.py:297', origin 'dataclass LoggerConfig'}
							log_validation_ppl_to_tensorboard {flag '--log-validation-ppl-to-tensorboard', default false, doc 'If set, write validation perplexity to tensorboard.', source 'megatron/training/config/training_config.py:300', origin 'dataclass LoggerConfig'}
							log_memory_to_tensorboard {flag '--log-memory-to-tensorboard', default false, doc 'Enable memory logging to tensorboard.', source 'megatron/training/config/training_config.py:303', origin 'dataclass LoggerConfig'}
							Integer log_memory_interval {flag '--log-memory-interval', doc 'Report memory interval.', source 'megatron/training/config/training_config.py:309', origin 'dataclass LoggerConfig'}
							log_device_memory_used {flag '--log-device-memory-used', default false, doc 'Log device memory used (as reported by nvidia-smi).', source 'megatron/training/config/training_config.py:312', origin 'dataclass LoggerConfig'}
							log_num_zeros_in_grad {flag '--log-num-zeros-in-grad', default false, doc 'If set, calculate and log the number of zeros in gradient.', source 'megatron/training/config/training_config.py:318', origin 'dataclass LoggerConfig'}
							log_max_attention_logit {flag '--log-max-attention-logit', default false, doc 'Enable max attention logit logging to tensorboard.', source 'megatron/training/config/training_config.py:321', origin 'dataclass LoggerConfig'}
							barrier_with_L1_time {flag '--no-barrier-with-level-1-timing', default true, doc 'If not disabled, use barrier with level 1 time measurements. Note that this is up to the user to make sure calling barrier with their timers will not result in hangs. This can happen if for example the user adds a level 1 timer that is not called by all ranks.', source 'megatron/training/config/training_config.py:330', origin 'dataclass LoggerConfig'}
							log_world_size_to_tensorboard {flag '--log-world-size-to-tensorboard', default false, doc 'Enable world size logging to tensorboard.', source 'megatron/training/config/training_config.py:336', origin 'dataclass LoggerConfig'}
							String wandb_project {flag '--wandb-project', doc 'The wandb project name. Ignore wandb by default.', source 'megatron/training/config/training_config.py:339', origin 'dataclass LoggerConfig'}
							String wandb_exp_name {flag '--wandb-exp-name', doc 'The wandb experiment name.', source 'megatron/training/config/training_config.py:342', origin 'dataclass LoggerConfig'}
							String wandb_save_dir {flag '--wandb-save-dir', doc 'Path to save the wandb results locally.', source 'megatron/training/config/training_config.py:345', origin 'dataclass LoggerConfig'}
							String wandb_entity {flag '--wandb-entity', doc 'The wandb entity name. It is useful when there are multiple sub-projects in a project.', source 'megatron/training/config/training_config.py:348', origin 'dataclass LoggerConfig'}
							Integer logging_level {flag '--logging-level', doc 'Set default logging level', source 'megatron/training/config/training_config.py:351', origin 'dataclass LoggerConfig'}
							log_energy {flag '--log-energy', default false, doc 'If set, log energy consumption (in Joules).', source 'megatron/training/config/training_config.py:363', origin 'dataclass LoggerConfig'}
							String moe_routing_trace_path {flag '--moe-routing-trace-path', doc 'Directory for MoE router decision traces (JSONL). When set, a RouterTracer is initialized at training start and hooks are registered on all TopKRouter modules. Traces are written in the same format as inference traces so the analysis scripts under tools/moe_routing work on both.', source 'megatron/training/config/training_config.py:369', origin 'dataclass LoggerConfig'}
							Integer moe_routing_trace_max_training_iters {flag '--moe-routing-trace-max-training-iters', doc 'Maximum number of training iterations to trace. Tracing stops automatically after this many calls to advance_step(). Defaults to tracing all iterations when moe_routing_trace_path is set. (Inference uses --moe-routing-trace-max-inference-steps instead.)', source 'megatron/training/config/training_config.py:375', origin 'dataclass LoggerConfig'}
							moe_routing_trace_capture_logits {flag '--moe-routing-trace-capture-logits', default false, doc 'Capture pre-topk routing logits for each router call.', source 'megatron/training/config/training_config.py:381', origin 'dataclass LoggerConfig'}
							moe_routing_trace_capture_hidden_states {flag '--moe-routing-trace-capture-hidden-states', default false, doc 'Capture input hidden-state tensors for each router call.', source 'megatron/training/config/training_config.py:384', origin 'dataclass LoggerConfig'}
							moe_routing_trace_dump_weights {flag '--moe-routing-trace-dump-weights', default false, doc 'Save router weight tensors to a .pt sidecar file.', source 'megatron/training/config/training_config.py:387', origin 'dataclass LoggerConfig'}
					OpentelemetryGroup {abstract, title 'opentelemetry', function '_add_logging_args', parameters 3}
						optional
							otel_enabled {flag '--otel-enabled', default false, doc 'Enable OpenTelemetry telemetry (traces and metrics). See MEGATRON_OTEL_ENABLED env var for the env-var equivalent.', source 'megatron/training/arguments.py:2782', origin 'argparse'}
							String otel_service_name {flag '--otel-service-name', doc 'Override OTEL_SERVICE_NAME for this training run.', source 'megatron/training/arguments.py:2789', origin 'argparse'}
							String otel_span_groups {flag '--otel-span-groups', doc 'Comma-separated span-group spec controlling which OTel instrumentation boundaries are active. Accepts preset keywords ("default", "per_step", "full", "all") or individual group names ("job", "checkpoint", "evaluate", "model_init", "load_checkpoint", "step", "forward_backward", "optimizer", "microbatch"), or a mix. Defaults to "default" (coarse job/checkpoint/evaluate spans only). Equivalent to MEGATRON_OTEL_SPAN_GROUPS env var.', source 'megatron/training/arguments.py:2795', origin 'argparse'}
					RegularizationGroup {abstract, title 'regularization', function '_add_regularization_args', parameters 23}
						mandatory
							Real weight_decay {flag '--weight-decay', default 0.01, doc 'Weight decay coefficient for L2 regularization.', source 'megatron/training/arguments.py:2814', origin 'argparse'}
							Real clip_grad {flag '--clip-grad', default 1.0, doc 'Gradient clipping based on global L2 norm.', source 'megatron/training/arguments.py:2818', origin 'argparse'}
							Real adam_beta1 {flag '--adam-beta1', default 0.9, doc 'First coefficient for computing running averages of gradient and its square', source 'megatron/training/arguments.py:2820', origin 'argparse'}
							Real adam_beta2 {flag '--adam-beta2', default 0.999, doc 'Second coefficient for computing running averages of gradient and its square', source 'megatron/training/arguments.py:2823', origin 'argparse'}
							Real adam_eps {flag '--adam-eps', default 0.00000001, doc 'Term added to the denominator to improvenumerical stability', source 'megatron/training/arguments.py:2826', origin 'argparse'}
							Real sgd_momentum {flag '--sgd-momentum', default 0.9, doc 'Momentum factor for sgd', source 'megatron/training/arguments.py:2829', origin 'argparse'}
							Real muon_momentum {flag '--muon-momentum', default 0.9, doc 'Momentum factor for Muon optimizer', source 'megatron/training/arguments.py:2831', origin 'argparse'}
							muon_scale_mode {flag '--muon-scale-mode', default 'spectral', doc 'Scale mode for Muon optimizer. With MuP, set --muon-scale-mode unit_rms_norm to use unit_rms_norm scaling, or set --muon-scale-mode spectral to keep spectral scaling.', source 'megatron/training/arguments.py:2838', origin 'argparse'}
								alternative
									muon_scale_mode_spectral {value 'spectral'}
									muon_scale_mode_unit_rms_norm {value 'unit_rms_norm'}
									muon_scale_mode_shape_scaling {value 'shape_scaling'}
							muon_fp32_matmul_prec {flag '--muon-fp32-matmul-prec', default 'medium', doc 'FP32 matmul precision for Newton-Schulz iteration', source 'megatron/training/arguments.py:2843', origin 'argparse'}
								alternative
									muon_fp32_matmul_prec_low {value 'low'}
									muon_fp32_matmul_prec_medium {value 'medium'}
									muon_fp32_matmul_prec_high {value 'high'}
							String muon_coefficient_type {flag '--muon-coefficient-type', default 'quintic', doc 'Newton-Schulz coefficient type for the Muon optimizer. Valid types are discovered from the installed emerging_optimizers package (e.g. simple, quintic, polar_express, aol). Validated at optimizer creation time.', source 'megatron/training/arguments.py:2846', origin 'argparse'}
							Integer muon_num_ns_steps {flag '--muon-num-ns-steps', default 5, doc 'Number of Newton-Schulz steps for Muon optimizer', source 'megatron/training/arguments.py:2851', origin 'argparse'}
							muon_tp_mode {flag '--muon-tp-mode', default 'duplicated', doc 'How to perform NS calculation for tensor model parallel weights. blockwise orthogonalizes each shard on its own, so the update rule depends on the parallelism config; duplicated and distributed both orthogonalize the whole matrix and give TP-invariant results; auto select between duplicated and distributed mode per-weight for dense weights; layer_sharded assigns each 2D weight one NS home rank in the (gtp_remat x tp) domain and routes the shards there with all_to_all (same math as duplicated, no redundant NS); requires --use-distributed-optimizer and --muon-no-split-qkv. See OptimizerConfig.muon_tp_mode.', source 'megatron/training/arguments.py:2853', origin 'argparse'}
								alternative
									muon_tp_mode_blockwise {value 'blockwise'}
									muon_tp_mode_duplicated {value 'duplicated'}
									muon_tp_mode_distributed {value 'distributed'}
									muon_tp_mode_auto {value 'auto'}
									muon_tp_mode_layer_sharded {value 'layer_sharded'}
							Integer muon_ns_batch_size {flag '--muon-ns-batch-size', default 1, doc 'Max number of same-shape matrices fused into one batched Newton-Schulz on an NS home under --muon-tp-mode layer_sharded. The default of 1 keeps the bit-exact per-matrix path; raise (e.g. to 32) to cut kernel launches on MoE expert homes at the cost of bitwise parity (baddbmm vs addmm rounding).', source 'megatron/training/arguments.py:2866', origin 'argparse'}
							Real muon_extra_scale_factor {flag '--muon-extra-scale-factor', default 1.0, doc 'Additional scale factor for the muon update', source 'megatron/training/arguments.py:2885', origin 'argparse'}
							muon_scalar_optimizer {flag '--muon-scalar-optimizer', default 'adam', doc 'Optimizer for scalar parameters (embeddings, biases, norms) when using muon. Defaults to adam.', source 'megatron/training/arguments.py:2887', origin 'argparse'}
								alternative
									muon_scalar_optimizer_adam {value 'adam'}
									muon_scalar_optimizer_lion {value 'lion'}
							Real lion_beta1 {flag '--lion-beta1', default 0.95, doc 'First beta coefficient for Lion optimizer (used in sign update). Default: 0.95.', source 'megatron/training/arguments.py:2891', origin 'argparse'}
							Real lion_beta2 {flag '--lion-beta2', default 0.98, doc 'Second beta coefficient for Lion optimizer (used in momentum EMA update). Default: 0.98.', source 'megatron/training/arguments.py:2894', origin 'argparse'}
						optional
							apply_wd_to_qk_layernorm {flag '--apply-wd-to-qk-layernorm', default false, doc 'Apply weight decay to qk layernorm as a special case.', source 'megatron/training/arguments.py:2816', origin 'argparse'}
							muon_split_qkv {flag '--muon-no-split-qkv', default true, doc 'Whether to split QKV parameters for Muon optimizer', source 'megatron/training/arguments.py:2833', origin 'argparse'}
							muon_nesterov {flag '--muon-nesterov', default false, doc 'Whether to use Nesterov-style momentum in the internal SGD', source 'megatron/training/arguments.py:2836', origin 'argparse'}
							muon_use_syrk {flag '--muon-use-syrk', default false, doc 'Use the Triton SYRK kernel for the symmetric-output Newton-Schulz GEMMs in Muon (~1/3 off NS FLOPs for near-square matrices). Takes effect only with --muon-fp32-matmul-prec medium. Under --muon-tp-mode layer_sharded, unmet Triton/SM/emerging-optimizers requirements are rejected at startup.', source 'megatron/training/arguments.py:2872', origin 'argparse'}
							muon_concurrent_groups {flag '--muon-no-concurrent-groups', default true, doc 'Serialize param groups on one CUDA stream under --muon-tp-mode layer_sharded instead of overlapping one group`s Newton-Schulz with another`s all_to_all. Bitwise-neutral; use when the concurrent transient buffers push peak memory too high.', source 'megatron/training/arguments.py:2879', origin 'argparse'}
							no_weight_decay_cond_type {flag '--no-weight-decay-cond-type', doc 'Type of no weight decay condition. Choices: None (default): apply weight decay to 1D weights and biases."apply_wd_to_qk_layernorm": additionally apply weight decay to qk layernorm as a special case.DEPRECATED. Please use --apply-wd-to-qk-layernorm instead.', source 'megatron/training/arguments.py:2898', origin 'argparse'}
								alternative
									no_weight_decay_cond_type_apply_wd_to_qk_layernorm {value 'apply_wd_to_qk_layernorm'}
					RlGroup {abstract, title 'rl', function '_add_rl_args', parameters 44}
						mandatory
							Integer rl_prompts_per_eval {flag '--rl-prompts-per-eval', default 32, doc 'Number of prompts to evaluate for for each RL task.This evaluation can be very expensive when using environmentsthat evaluate pass@k so we default to a lower number.', source 'megatron/training/arguments.py:2911', origin 'argparse'}
							Integer grpo_prompts_per_step {flag '--grpo-prompts-per-step', default 32, doc 'Number of GRPO groups (G in the paper).', source 'megatron/training/arguments.py:2916', origin 'argparse'}
							Integer grpo_group_size {flag '--grpo-group-size', default 2, doc 'Number of samples per a GRPO group.', source 'megatron/training/arguments.py:2918', origin 'argparse'}
							rl_submission_granularity {flag '--rl-submission-granularity', default 'B', doc 'Granularity for submitting rollout generation work. R submits individual rollouts independently while still yielding complete rollout groups to training. G submits one rollout group at a time. B submits grpo_prompts_per_step rollout groups together.', source 'megatron/training/arguments.py:2936', origin 'argparse'}
								alternative
									rl_submission_granularity_R {value 'R'}
									rl_submission_granularity_G {value 'G'}
									rl_submission_granularity_B {value 'B'}
							rl_consumption_granularity {flag '--rl-consumption-granularity', default 'B', doc 'Granularity for consuming generated rollout groups. G consumes groups as they complete. B consumes complete trainer batches in submission order. R is not currently supported.', source 'megatron/training/arguments.py:2944', origin 'argparse'}
								alternative
									rl_consumption_granularity_R {value 'R'}
									rl_consumption_granularity_G {value 'G'}
									rl_consumption_granularity_B {value 'B'}
							Integer rl_rollout_bank_max_bytes {flag '--rl-rollout-bank-max-bytes', default 0, doc 'Soft cap (bytes) on the rollout bank size; 0 = unbounded. On exceed, a warning is logged. Compaction occurs at the next checkpoint regardless of the cap and never blocks generation.', source 'megatron/training/arguments.py:2958', origin 'argparse'}
							Integer grpo_iterations {flag '--grpo-iterations', default 2, doc 'Number of iterations per a GRPO implementation.', source 'megatron/training/arguments.py:2962', origin 'argparse'}
							Real grpo_clamp_eps_lower {flag '--grpo-clamp-eps-lower', default 0.01, doc 'Lower GRPO clipping bound.', source 'megatron/training/arguments.py:2966', origin 'argparse'}
							Real grpo_clamp_eps_upper {flag '--grpo-clamp-eps-upper', default 0.01, doc 'Upper GRPO clipping bound. In vanilla implementation, equals to the lower one.', source 'megatron/training/arguments.py:2968', origin 'argparse'}
							Real grpo_kl_beta {flag '--grpo-kl-beta', default 0.001, doc 'KL term weight in the GRPO loss.', source 'megatron/training/arguments.py:2970', origin 'argparse'}
							Real grpo_entropy_term_weight {flag '--grpo-entropy-term-weight', default 0.0, doc 'Entropy term weight in GRPO loss.', source 'megatron/training/arguments.py:2972', origin 'argparse'}
							Real rl_default_temperature {flag '--rl-default-temperature', default 1.0, doc 'Default temperature for model inference.', source 'megatron/training/arguments.py:2978', origin 'argparse'}
							Real rl_default_top_p {flag '--rl-default-top-p', default 0, doc 'Default top-p for model inference.', source 'megatron/training/arguments.py:2980', origin 'argparse'}
							Integer rl_default_top_k {flag '--rl-default-top-k', default -1, doc 'Default top-k for model inference.', source 'megatron/training/arguments.py:2982', origin 'argparse'}
							rl_kv_cache_management_mode {flag '--rl-kv-cache-management-mode', default 'persist', doc 'KV cache management mode during RL training: persist: leave KV cache in GPU memory (default), offload: offload KV cache to CPU during training, recompute: deallocate KV cache and recompute from scratch each cycle', source 'megatron/training/arguments.py:2986', origin 'argparse'}
								alternative
									rl_kv_cache_management_mode_persist {value 'persist'}
									rl_kv_cache_management_mode_offload {value 'offload'}
									rl_kv_cache_management_mode_recompute {value 'recompute'}
							Integer rl_sequence_packing_max_sequences_per_bin {flag '--rl-sequence-packing-max-sequences-per-bin', default 50, doc 'Maximum number of sequences that can be packed into a single bin.', source 'megatron/training/arguments.py:3006', origin 'argparse'}
							rl_sequence_packing_algo {flag '--rl-sequence-packing-algo', default 'fifo', doc 'Algorithm for distributing packed bins across ranks. fifo: first-in-first-out sequential distribution, round-robin: distribute bins cyclically across ranks for better load balancing', source 'megatron/training/arguments.py:3008', origin 'argparse'}
								alternative
									rl_sequence_packing_algo_fifo {value 'fifo'}
									rl_sequence_packing_algo_round_robin {value 'round-robin'}
							rl_inference_model_unified_memory_level {flag '--rl-inference-model-unified-memory-level', default 0, doc 'Allocate the separate RL inference model parameters from a unified virtual memory (UVM) CUDA mempool. Level 0 disables UVM (default). Level 1 enables UVM allocation so the inference model weights can be prefetched to CPU when idle while keeping CUDA-graph-safe device pointers.', source 'megatron/training/arguments.py:3038', origin 'argparse'}
								alternative
									rl_inference_model_unified_memory_level_0 {value 0}
									rl_inference_model_unified_memory_level_1 {value 1}
							refit_method {flag '--refit-method', default 'gloo', doc 'Method to refit model weights. nccl: use NCCLCopyService; nccl_m2n: use the official NCCL M2N API from a non-RL launcher such as the ReFIT benchmark; gloo: use GlooCopyService over CPU; nvshmem: use NVSHMEMCopyService; nixl: use NixlCopyService.', source 'megatron/training/arguments.py:3062', origin 'argparse'}
								alternative
									refit_method_nccl {value 'nccl'}
									refit_method_nccl_m2n {value 'nccl_m2n'}
									refit_method_gloo {value 'gloo'}
									refit_method_nvshmem {value 'nvshmem'}
									refit_method_nixl {value 'nixl'}
						optional
							perform_rl_step {flag '--perform-rl-step', default false, doc 'Use the RL training step.', source 'megatron/training/arguments.py:2909', origin 'argparse'}
							Real rl_generation_lag {flag '--rl-generation-lag', doc 'Number of trainer batches of rollout generation lag to allow The number of in-flight trainer batches is this value plus one. May be fractional or negative; the minimum of -1 keeps a single unit of generation work in flight. If omitted, the lag is autotuned to the inference engine`s request capacity when --rl-partial-rollouts is set, and is 0 otherwise. Requires --rl-partial-rollouts when greater than 0. Mutually exclusive with --rl-max-inflight-requests.', source 'megatron/training/arguments.py:2920', origin 'argparse'}
							Integer rl_max_inflight_requests {flag '--rl-max-inflight-requests', doc 'Maximum number of inference requests RL generation may keep inflight: equivalent to (--rl-generation-lag + 1) training batches of grpo_prompts_per_step * grpo_group_size requests each. Requires --rl-partial-rollouts when above one training batch; mutually exclusive with --rl-generation-lag.', source 'megatron/training/arguments.py:2929', origin 'argparse'}
							rl_durable_rollout_bank {flag '--rl-durable-rollout-bank', default false, doc 'Persist completed rollout groups to a durable, write-through ledger so they survive a SIGKILL (the SLURM time limit) and are restored at restart instead of regenerated. No-op when unset.', source 'megatron/training/arguments.py:2951', origin 'argparse'}
							String rl_rollout_bank_dir {flag '--rl-rollout-bank-dir', doc 'Directory for the durable rollout bank (on Lustre). Defaults to <save>/rollout_bank so the bank stays coupled to the checkpoint.', source 'megatron/training/arguments.py:2955', origin 'argparse'}
							grpo_filter_groups_with_same_reward {flag '--grpo-filter-groups-with-same-reward', default false, doc 'Filter groups with same reward.', source 'megatron/training/arguments.py:2974', origin 'argparse'}
							String langrl_env_config {flag '--langrl-env-config', doc 'Path to YAML config file for RL environment configuration.', source 'megatron/training/arguments.py:2976', origin 'argparse'}
							rl_offload_optimizer_during_inference {flag '--rl-offload-optimizer-during-inference', default false, doc 'Offload optimizer state to CPU during inference/rollout to save GPU memory', source 'megatron/training/arguments.py:2984', origin 'argparse'}
							rl_persist_cuda_graphs {flag '--rl-persist-cuda-graphs', default false, doc 'Persist CUDA graphs when the inference engine is suspended. If False, CUDA graphs are deleted on suspend and re-captured on resume.', source 'megatron/training/arguments.py:2992', origin 'argparse'}
							rl_partial_rollouts {flag '--rl-partial-rollouts', default false, doc 'Allow inference to continue generating rollouts while training updates the policy weights. This enables off-policy training where rollouts may be generated with a stale version of the policy. Use --rl-generation-lag to control the degree of staleness.', source 'megatron/training/arguments.py:2995', origin 'argparse'}
							rl_inference_logprobs_is_correction {flag '--rl-inference-logprobs-is-correction', default false, doc 'If set, use inference logprobs in importance sampling correction of the loss.', source 'megatron/training/arguments.py:3000', origin 'argparse'}
							Real rl_importance_sampling_truncation_coef {flag '--rl-importance-sampling-truncation-coef', doc 'If --inference-logprobs-is-correction is on and this coefficient is set, apply truncation for the IS correction at GRPO loss.', source 'megatron/training/arguments.py:3002', origin 'argparse'}
							rl_use_sequence_packing {flag '--rl-use-sequence-packing', default false, doc 'Enable sequence packing', source 'megatron/training/arguments.py:3004', origin 'argparse'}
							rl_training_cuda_graphs {flag '--rl-training-cuda-graphs', default false, doc 'If set, do not toggle CUDA graphs on/off between inference and training phases.', source 'megatron/training/arguments.py:3013', origin 'argparse'}
							Integer rl_inference_tensor_model_parallel_size {flag '--rl-inference-tensor-model-parallel-size', doc 'Degree of tensor model parallelism for inference for RL.', source 'megatron/training/arguments.py:3016', origin 'argparse'}
							Integer rl_inference_pipeline_model_parallel_size {flag '--rl-inference-pipeline-model-parallel-size', doc 'Degree of pipeline model parallelism for inference for RL.', source 'megatron/training/arguments.py:3018', origin 'argparse'}
							Integer rl_inference_expert_model_parallel_size {flag '--rl-inference-expert-model-parallel-size', doc 'Degree of expert model parallelism for inference for RL.', source 'megatron/training/arguments.py:3024', origin 'argparse'}
							Integer rl_inference_expert_tensor_model_parallel_size {flag '--rl-inference-expert-tensor-model-parallel-size', doc 'Degree of expert tensor model parallelism for inference for RL. For MoE models, this controls the TP size for expert layers specifically. Defaults to training expert_tensor_parallel_size if not specified.', source 'megatron/training/arguments.py:3030', origin 'argparse'}
							rl_offload_inference_model_weights_when_idle {flag '--rl-offload-inference-model-weights-when-idle', default false, doc 'When using a separate RL inference model, offload its weights to CPU when not doing rollout inference, and restore to GPU right before inference. Works with two backends: 1) UVM (when --rl-inference-model-unified-memory-level=1), or 2) torch_memory_saver (when UVM is not enabled; requires torch_memory_saver to be installed).', source 'megatron/training/arguments.py:3050', origin 'argparse'}
							Integer refit_execution_batch_bytes {flag '--refit-execution-batch-bytes', doc 'Optional soft per-rank byte limit for ReFIT execution staging. The default None preserves one model-wide generic submission and NCCL M2N`s existing 256 MiB default.', source 'megatron/training/arguments.py:3071', origin 'argparse'}
							rl_verify_model_weights_swap {flag '--rl-verify-model-weights-swap', default false, doc 'If set, verify that the model weights were correctly transferred by comparing forward pass outputs onthe first swap of model weights.', source 'megatron/training/arguments.py:3081', origin 'argparse'}
							rl_skip_bos_token {flag '--rl-skip-bos-token', default false, doc 'Skip BOS token at the beginning of the sequences. Default is False.', source 'megatron/training/arguments.py:3085', origin 'argparse'}
							rl_profile {flag '--rl-profile', default false, doc 'Enable RL profiling to collect detailed timer data (JSONL + CSV).', source 'megatron/training/arguments.py:3087', origin 'argparse'}
							String rl_profile_dir {flag '--rl-profile-dir', doc 'Directory to write RL profiling data. Defaults to {save}/profiles.', source 'megatron/training/arguments.py:3089', origin 'argparse'}
							String rl_inference_parsers {flag '--rl-inference-parsers', default '[]', doc 'List of response parsers to enable for RL inference (e.g. --rl-inference-parsers deepseek-r1-reasoning qwen3-coder-tool). qwen3-coder-tool-combined additionally treats <tool_call> as the end of an unterminated reasoning block, like vLLM`s combined qwen3 parser.', source 'megatron/training/arguments.py:3091', origin 'argparse', nargs '*'}
					ProfilingGroup {abstract, title 'profiling', function '_add_training_args', doc 'ProfilingConfig: Configuration settings for profiling the training process.', parameters 12}
						mandatory
							Integer profile_step_start {flag '--profile-step-start', default 10, doc 'Global step to start profiling.', source 'megatron/training/config/common_config.py:37', origin 'dataclass ProfilingConfig'}
							Integer profile_step_end {flag '--profile-step-end', default 12, doc 'Global step to stop profiling.', source 'megatron/training/config/common_config.py:40', origin 'dataclass ProfilingConfig'}
							String memory_snapshot_path {flag '--memory-snapshot-path', default 'snapshot.pickle', doc 'Specifies where to dump the memory history pickle.', source 'megatron/training/config/common_config.py:63', origin 'dataclass ProfilingConfig'}
						optional
							use_pytorch_profiler {flag '--use-pytorch-profiler', default false, doc 'Use the built-in pytorch profiler, mutually exclusive with use_nsys_profiler. The legacy CLI requires both --profile and --use-pytorch-profiler to select this backend. Useful if you wish to view profiles in tensorboard.', source 'megatron/training/config/common_config.py:43', origin 'dataclass ProfilingConfig'}
							pytorch_profiler_collect_shapes {flag '--pytorch-profiler-collect-shapes', default false, doc 'Collect tensor shape in pytorch profiler.', source 'megatron/training/config/common_config.py:48', origin 'dataclass ProfilingConfig'}
							pytorch_profiler_collect_callstack {flag '--pytorch-profiler-collect-callstack', default false, doc 'Collect callstack in pytorch profiler.', source 'megatron/training/config/common_config.py:51', origin 'dataclass ProfilingConfig'}
							pytorch_profiler_collect_chakra {flag '--pytorch-profiler-collect-chakra', default false, doc 'Collect chakra trace in pytorch profiler.', source 'megatron/training/config/common_config.py:54', origin 'dataclass ProfilingConfig'}
							String profile_ranks {flag '--profile-ranks', default '[]', doc 'Global ranks to profile.', source 'megatron/training/config/common_config.py:57', origin 'dataclass ProfilingConfig', nargs '+', element_type 'int'}
							record_memory_history {flag '--record-memory-history', default false, doc 'Record memory history in last rank.', source 'megatron/training/config/common_config.py:60', origin 'dataclass ProfilingConfig'}
							record_shapes {flag '--record-shapes', default false, doc 'Record shapes of tensors in `torch.autograd.profiler.emit_nvtx` for the Nsys profiler.', source 'megatron/training/config/common_config.py:66', origin 'dataclass ProfilingConfig'}
							nvtx_ranges {flag '--nvtx-ranges', default false, doc 'Enable NVTX range annotations for profiling. When enabled, inserts NVTX markers to categorize execution in profiler output.', source 'megatron/training/config/common_config.py:69', origin 'dataclass ProfilingConfig'}
							profile {flag '--profile', default false, doc 'Enable nsys profiling. When using this option, nsys options should be specified in commandline.', source 'megatron/training/arguments.py:3103', origin 'argparse'}
					TrainingGroup {abstract, title 'training', function '_add_training_args', doc 'TrainingConfig: Configuration settings related to the training loop.', parameters 49}
						mandatory
							empty_unused_memory_level {flag '--empty-unused-memory-level', default 0, doc 'Call torch.cuda.empty_cache() each iteration (training and eval), to reduce fragmentation. 0=off, 1=moderate, 2=aggressive.', source 'megatron/training/config/training_config.py:48', origin 'dataclass TrainingConfig'}
								alternative
									empty_unused_memory_level_0 {value 0}
									empty_unused_memory_level_1 {value 1}
									empty_unused_memory_level_2 {value 2}
							exit_signal {flag '--exit-signal', default 'SIGTERM', doc 'Signal for the signal handler to detect.', source 'megatron/training/config/training_config.py:82', origin 'dataclass TrainingConfig'}
								alternative
									exit_signal_SIGTERM {value 'SIGTERM'}
									exit_signal_SIGINT {value 'SIGINT'}
									exit_signal_SIGUSR1 {value 'SIGUSR1'}
									exit_signal_SIGUSR2 {value 'SIGUSR2'}
									exit_signal_SIGHUP {value 'SIGHUP'}
									exit_signal_SIGQUIT {value 'SIGQUIT'}
							Integer manual_gc_interval {flag '--manual-gc-interval', default 0, doc 'Training step interval to trigger manual garbage collection. Values > 0 will trigger garbage collections between training steps.', source 'megatron/training/config/training_config.py:97', origin 'dataclass TrainingConfig'}
							optimizer {flag '--optimizer', default 'adam', doc 'Optimizer function. Note: dist_muon is deprecated; use --optimizer muon with --use-distributed-optimizer instead.', source 'megatron/training/arguments.py:3164', origin 'argparse'}
								alternative
									optimizer_adam {value 'adam'}
									optimizer_sgd {value 'sgd'}
									optimizer_muon {value 'muon'}
									optimizer_dist_muon {value 'dist_muon'}
									optimizer_lion {value 'lion'}
									optimizer_soap {value 'soap'}
									optimizer_adaptive_muon {value 'adaptive_muon'}
							Real optimizer_offload_fraction {flag '--optimizer-offload-fraction', default 1.0, doc 'Ratio of optimizer state to offload to CPU', source 'megatron/training/arguments.py:3173', origin 'argparse'}
						optional
							Integer micro_batch_size {flag '--micro-batch-size', doc 'Batch size per model instance (local batch size). Global batch size is local batch size times data parallel size times number of micro batches.', source 'megatron/training/config/training_config.py:11', origin 'dataclass TrainingConfig'}
							Integer global_batch_size {flag '--global-batch-size', doc 'Training batch size. If set, it should be a multiple of micro-batch-size times data-parallel-size. If this value is None, then use micro-batch-size * data-parallel-size as the global batch size. This choice will result in 1 for number of micro-batches.', source 'megatron/training/config/training_config.py:15', origin 'dataclass TrainingConfig'}
							String rampup_batch_size {flag '--rampup-batch-size', doc 'Batch size ramp up with the following values: <start batch size>, <batch size increment>, <ramp-up samples> For example: rampup-batch-size = [16, 8, 300000] global-batch-size 1024 will start with global batch size 16 and over (1024 - 16) / 8 = 126 intervals will increase the batch size linearly to 1024. In each interval we will use approximately 300000 / 126 = 2380 samples. Deprecated. Use step_batch_size_schedule instead.', source 'megatron/training/config/training_config.py:20', origin 'dataclass TrainingConfig', nargs '3', element_type 'int'}
							String step_batch_size_schedule {flag '--step-batch-size-schedule', doc 'Step-wise batch size schedule in format "THRESHOLD:BS THRESHOLD:BS ...". Thresholds support suffixes: K (1e3), M (1e6), B (1e9), T (1e12). If sequence length is provided, thresholds are interpreted as tokens; otherwise as samples. Example: step_batch_size_schedule = "0:768 250B:1536 500B:3072 750B:6144" Cannot be used together with decrease_batch_size_if_needed.', source 'megatron/training/config/training_config.py:32', origin 'dataclass TrainingConfig'}
							decrease_batch_size_if_needed {flag '--decrease-batch-size-if-needed', default false, doc 'If set, decrease batch size if microbatch_size * dp_size does not divide batch_size. Old batch_size will be restored if training is re-started with dp_size that divides batch_size // microbatch_size. Not supported with step-batch-size-schedule.', source 'megatron/training/config/training_config.py:42', origin 'dataclass TrainingConfig'}
							Integer check_weight_hash_across_dp_replicas_interval {flag '--check-weight-hash-across-dp-replicas-interval', doc 'Interval to check weight hashes are same across DP replicas. If not specified, weight hashes not checked.', source 'megatron/training/config/training_config.py:53', origin 'dataclass TrainingConfig'}
							Integer gpu_sniff_test_interval {flag '--gpu-sniff-test-interval', doc 'Interval (in iterations) to run GPU performance sniff tests (GEMMs, all-to-all, send/recv). Flags any rank whose throughput differs from the mean by more than one standard deviation. If not specified, sniff tests are not run.', source 'megatron/training/config/training_config.py:56', origin 'dataclass TrainingConfig'}
							Integer train_sync_interval {flag '--train-sync-interval', doc 'Training CPU-GPU synchronization interval, to ensure that CPU is not running too far ahead of GPU.', source 'megatron/training/config/training_config.py:61', origin 'dataclass TrainingConfig'}
							Integer train_iters {flag '--train-iters', doc 'Total number of iterations to train over all training runs. Note that either train_iters or train_samples should be provided.', source 'megatron/training/config/training_config.py:64', origin 'dataclass TrainingConfig'}
							Integer train_samples {flag '--train-samples', doc 'Total number of samples to train over all training runs. Note that either train_iters or train_samples should be provided.', source 'megatron/training/config/training_config.py:69', origin 'dataclass TrainingConfig'}
							Integer exit_interval {flag '--exit-interval', doc 'Exit the program after the iteration is divisible by this value.', source 'megatron/training/config/training_config.py:73', origin 'dataclass TrainingConfig'}
							Integer exit_duration_in_mins {flag '--exit-duration-in-mins', doc 'Exit the program after this many minutes.', source 'megatron/training/config/training_config.py:76', origin 'dataclass TrainingConfig'}
							exit_signal_handler {flag '--exit-signal-handler', default false, doc 'Dynamically save the checkpoint and shutdown the training if SIGTERM is received', source 'megatron/training/config/training_config.py:79', origin 'dataclass TrainingConfig'}
							exit_signal_handler_for_dataloader {flag '--exit-signal-handler-for-dataloader', default false, doc 'Use signal handler for dataloader workers', source 'megatron/training/config/training_config.py:85', origin 'dataclass TrainingConfig'}
							exit_signal_handler_for_training {flag '--exit-signal-handler-for-training', default false, doc 'Shutdown the training when SIGINT or SIGTERM received to avoid unclear traceback', source 'megatron/training/config/training_config.py:88', origin 'dataclass TrainingConfig'}
							manual_gc {flag '--manual-gc', default false, doc 'Disable the threshold-based default garbage collector and trigger the garbage collection manually. Manual garbage collection helps to align the timing of the collection across ranks which mitigates the impact of CPU-associated jitters. When the manual gc is enabled, garbage collection is performed only at the start and the end of the validation routine by default.', source 'megatron/training/config/training_config.py:91', origin 'dataclass TrainingConfig'}
							manual_gc_eval {flag '--no-manual-gc-eval --disable-manual-gc-eval', default true, doc 'When using manual garbage collection, this controls garbage collection at the start and the end of each evaluation run.', source 'megatron/training/config/training_config.py:102', origin 'dataclass TrainingConfig'}
							String iterations_to_skip {flag '--iterations-to-skip', default '[]', doc 'List of 1-indexed iterations to skip during training, empty by default.', source 'megatron/training/config/training_config.py:107', origin 'dataclass TrainingConfig', nargs '+', element_type 'int'}
							train_full_dataset {flag '--train-full-dataset', default false, doc 'Train for one complete pass over an externally provided dataset.', source 'megatron/training/arguments.py:3111', origin 'argparse'}
							Integer batch_size {flag '--batch-size', doc 'Old batch size parameter, do not use. Use --micro-batch-size instead', source 'megatron/training/arguments.py:3117', origin 'argparse'}
							recompute_activations {flag '--recompute-activations', default false, doc 'recompute activation to allow for training with larger models, sequences, and batch sizes.', source 'megatron/training/arguments.py:3120', origin 'argparse'}
							check_for_nan_in_loss_and_grad {flag '--no-check-for-nan-in-loss-and-grad', default true, doc 'Check for NaNs in loss and grad', source 'megatron/training/arguments.py:3123', origin 'argparse'}
							check_for_large_grads {flag '--check-for-large-grads', default false, doc 'Check for unexpectedly large grads', source 'megatron/training/arguments.py:3126', origin 'argparse'}
							String result_rejected_tracker_filename {flag '--result-rejected-tracker-filename', doc 'Optional name of file tracking `result_rejected` events.', source 'megatron/training/arguments.py:3129', origin 'argparse'}
							String tp_comm_overlap_cfg {flag '--tp-comm-overlap-cfg', doc 'Config file when tp_comm_overlap is enabled.', source 'megatron/training/arguments.py:3131', origin 'argparse'}
							checkpoint_activations {flag '--checkpoint-activations', default false, doc 'Checkpoint activation to allow for training with larger models, sequences, and batch sizes.', source 'megatron/training/arguments.py:3135', origin 'argparse'}
							masked_softmax_fusion {flag '--no-masked-softmax-fusion', default true, doc 'Disable fusion of query_key_value scaling, masking, and softmax.', source 'megatron/training/arguments.py:3138', origin 'argparse'}
							bias_gelu_fusion {flag '--no-bias-gelu-fusion', default true, doc 'Disable bias and gelu fusion.', source 'megatron/training/arguments.py:3143', origin 'argparse'}
							bias_swiglu_fusion {flag '--no-bias-swiglu-fusion', default true, doc 'Disable bias and swiglu fusion, the fusion is available only when using megatron-core.', source 'megatron/training/arguments.py:3146', origin 'argparse'}
							bias_dropout_fusion {flag '--no-bias-dropout-fusion', default true, doc 'Disable bias and dropout fusion.', source 'megatron/training/arguments.py:3150', origin 'argparse'}
							apply_rope_fusion {flag '--no-rope-fusion', default true, doc 'Disable rope fusion, the fusion is available only when using megatron-core.', source 'megatron/training/arguments.py:3153', origin 'argparse'}
							rope_type {flag '--rope-type', doc 'Type of rope to use. Note that MLA takes yarn by default, and common attention takes rope by default.', source 'megatron/training/arguments.py:3157', origin 'argparse'}
								alternative
									rope_type_rope {value 'rope'}
									rope_type_yarn {value 'yarn'}
							use_flash_attn {flag '--use-flash-attn', default false, doc 'use FlashAttention implementation of attention. https://arxiv.org/abs/2205.14135', source 'megatron/training/arguments.py:3161', origin 'argparse'}
							optimizer_cpu_offload {flag '--optimizer-cpu-offload', default false, doc 'Offload optimizer state to CPU', source 'megatron/training/arguments.py:3169', origin 'argparse'}
							optimizer_cuda_graph {flag '--optimizer-cuda-graph', default false, doc 'Enable CUDA graph for optimizer step', source 'megatron/training/arguments.py:3171', origin 'argparse'}
							use_torch_optimizer_for_cpu_offload {flag '--use-torch-optimizer-for-cpu-offload', default false, doc 'Use torch.optim.Optimizer instead of Megatron`s optimizer in optimizer cpu offload mode.', source 'megatron/training/arguments.py:3175', origin 'argparse'}
							overlap_cpu_optimizer_d2h_h2d {flag '--overlap-cpu-optimizer-d2h-h2d', default false, doc 'Overlap CPU optimizer step, gradients D2H and updated parameters H2D.', source 'megatron/training/arguments.py:3177', origin 'argparse'}
							String dump_param_to_param_group_map {flag '--dump-param-to-param-group-map', doc 'Path to a file containing parameter-to-parameter-group mapping. Provide a JSON file that specifies which parameters belong to which parameter group for global coordination.', source 'megatron/training/arguments.py:3179', origin 'argparse'}
							pin_cpu_grads {flag '--no-pin-cpu-grads', default true, doc 'Disable pinning of CPU memory for gradients.', source 'megatron/training/arguments.py:3183', origin 'argparse'}
							pin_cpu_params {flag '--no-pin-cpu-params', default true, doc 'Disable pinning of CPU memory for parameters.', source 'megatron/training/arguments.py:3185', origin 'argparse'}
							dataloader_type {flag '--dataloader-type', doc 'Single pass vs multiple pass data loader', source 'megatron/training/arguments.py:3187', origin 'argparse'}
								alternative
									dataloader_type_single {value 'single'}
									dataloader_type_cyclic {value 'cyclic'}
									dataloader_type_external {value 'external'}
							no_persist_layer_norm {flag '--no-persist-layer-norm', default false, doc 'Disable using persistent fused layer norm kernel. This kernel supports only a set of hidden sizes. Please check persist_ln_hidden_sizes if your hidden size is supported.', source 'megatron/training/arguments.py:3190', origin 'argparse'}
							gradient_accumulation_fusion {flag '--no-gradient-accumulation-fusion', default true, doc 'Disable fusing gradient accumulation to weight gradient computation of linear layers', source 'megatron/training/arguments.py:3195', origin 'argparse'}
							deprecated_use_mcore_models {flag '--use-mcore-models', default false, doc 'DEPRECATED. Use the implementation from megatron core.Now ignored and mcore models are the default.', source 'megatron/training/arguments.py:3200', origin 'argparse'}
					RerunEngineGroup {abstract, title 'rerun engine', function '_add_rerun_machine_args', doc 'RerunStateMachineConfig: Configuration for the rerun state machine used for result validation or stats.', parameters 4}
						mandatory
