							calc_ft_timeouts {flag '--calc-ft-timeouts', default false, doc 'If set, FT package will try to automatically compute the timeouts. Note: This feature is for Nvidia internal use only.', source 'megatron/training/arguments.py:2764', origin 'argparse'}
					LoggingGroup {abstract, title 'logging', function '_add_logging_args', doc 'LoggerConfig: Configuration settings for logging, including TensorBoard and WandB.', parameters 30}
						mandatory
							Integer log_interval {flag '--log-interval', default 100, doc 'Report loss and timing interval.', source 'megatron/training/config/training_config.py:247', origin 'dataclass LoggerConfig'}
							timing_log_level {flag '--timing-log-level', default 0, doc 'Granularity level to measure and report timing. 0: report only iteration time and make sure timing does not introduce extra overhead. 1: report timing for operations that are executed very limited times (basically once) during each iteration (such as gradient all-reduce) 2: report timing for operations that migh be executed numerous times during each iteration. Note that setting the level to 1 or 2 might cause increase in iteration time.', source 'megatron/training/config/training_config.py:267', origin 'dataclass LoggerConfig'}
								alternative
									timing_log_level_0 {value 0}
