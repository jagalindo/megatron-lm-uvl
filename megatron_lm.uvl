							cross_entropy_fusion_impl {flag '--cross-entropy-fusion-impl', default 'native', doc 'If `native`, MCore based CE loss fusion is used, if `te`, Parallel CE loss from Transformer Engine library is used. Defaults to `native`.', source 'megatron/core/model_parallel_config.py:331', origin 'dataclass TransformerConfig'}
