	perform_rl_step => !rl_consumption_granularity_R
	// arguments.py:589 submission B with consumption G not supported
	perform_rl_step => !(rl_submission_granularity_B & rl_consumption_granularity_G)
	// arguments.py:597 RL sequence packing requires micro_batch_size == 1
	(perform_rl_step & rl_use_sequence_packing) => micro_batch_size == 1
	// arguments.py:617 a2a+p2p cp comm requires --hierarchical-context-parallel-sizes (cp_comm_type is a list; approximated as equality)
	cp_comm_type == 'a2a+p2p' => hierarchical_context_parallel_sizes
	// arguments.py:624 --batch-size is deprecated/invalid
	!batch_size
	// arguments.py:627 --warmup is deprecated/invalid
	!warmup
	// arguments.py:630 --model-parallel-size is deprecated/invalid
	!model_parallel_size
	// arguments.py:637 --checkpoint-activations is no longer valid (exit())
	!checkpoint_activations
	// arguments.py:645 deprecated --enable-cuda-graph/--external-cuda-graph cannot be combined with --cuda-graph-impl
	(enable_cuda_graph | external_cuda_graph) => cuda_graph_impl_none
	// arguments.py:648 --enable-cuda-graph and --external-cuda-graph are mutually exclusive
	!(enable_cuda_graph & external_cuda_graph)
	// arguments.py:667 --cuda-graph-scope (deprecated) and --cuda-graph-modules cannot be used together
	cuda_graph_scope_deprecated => !cuda_graph_modules
	// arguments.py:710 --data-path and --data-args-path are mutually exclusive
	!(data_path & data_args_path)
	// arguments.py:717 per-split data paths and --per-split-data-args-path are mutually exclusive
	!((train_data_path | valid_data_path | test_data_path) & per_split_data_args_path)
	// arguments.py:726 --micro-batch-size is required
	micro_batch_size
