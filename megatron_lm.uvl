							Integer num_speculative_tokens {flag '--num-speculative-tokens', default 0, doc 'Number of speculative tokens generated during decode', source 'megatron/training/arguments.py:2280', origin 'argparse'}
							inference_dynamic_batching_prefix_caching_eviction_policy {flag '--inference-dynamic-batching-prefix-caching-eviction-policy', default 'lru', doc 'Eviction policy for prefix caching blocks. "ref_zero" immediately returns blocks to the free pool when ref_count hits 0. "lru" (default) keeps blocks cached and evicts via LRU only when space is needed.', source 'megatron/training/arguments.py:2289', origin 'argparse'}
								alternative
