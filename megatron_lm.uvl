									inference_dynamic_batching_prefix_caching_eviction_policy_lru {value 'lru'}
							inference_dynamic_batching_prefix_caching_coordinator_policy {flag '--inference-dynamic-batching-prefix-caching-coordinator-policy', default 'longest_prefix', doc 'Coordinator routing policy for prefix caching. "load_balanced" routes to the rank with the fewest in-flight requests, ignoring prefix affinity. "first_prefix_block" routes based on the first block hash only. "longest_prefix" (default) routes to the rank with the longest matching prefix. "first_prefix_block" and "longest_prefix" both combine prefix affinity with load balancing and fall back to load-balanced routing when prefix caching is disabled or no prefix match exists.', source 'megatron/training/arguments.py:2297', origin 'argparse'}
								alternative
									inference_dynamic_batching_prefix_caching_coordinator_policy_longest_prefix {value 'longest_prefix'}
									inference_dynamic_batching_prefix_caching_coordinator_policy_first_prefix_block {value 'first_prefix_block'}
									inference_dynamic_batching_prefix_caching_coordinator_policy_load_balanced {value 'load_balanced'}
							Real inference_dynamic_batching_prefix_caching_routing_alpha {flag '--inference-dynamic-batching-prefix-caching-routing-alpha', default 1.0, doc 'How hard to penalise load when routing on prefix affinity: score = cache_score - alpha * relative_load, where relative_load is a rank load measured against the fleet mean. 0 is pure prefix affinity; higher values divert to idle ranks more readily as the fleet becomes lopsided. Dimensionless and not capped at 1. Default: 0.5.', source 'megatron/training/arguments.py:2310', origin 'argparse'}
							Real inference_dynamic_batching_prefix_cache_ttl_seconds {flag '--inference-dynamic-batching-prefix-cache-ttl-seconds', default 300.0, doc 'How long the coordinator assumes an engine still holds a block it routed there. The coordinator never observes evictions, so entries untouched for this long are dropped rather than kept forever. Default: 300.0.', source 'megatron/training/arguments.py:2319', origin 'argparse'}
							inference_dynamic_batching_media_cache_coordinator_policy {flag '--inference-dynamic-batching-media-cache-coordinator-policy', default 'affinity', doc 'Coordinator routing policy for media caching. "affinity" prefers a rank assigned the same media; "load_balanced" ignores standalone media affinity.', source 'megatron/training/arguments.py:2326', origin 'argparse'}
								alternative
									inference_dynamic_batching_media_cache_coordinator_policy_affinity {value 'affinity'}
									inference_dynamic_batching_media_cache_coordinator_policy_load_balanced {value 'load_balanced'}
							Real inference_dynamic_batching_media_cache_routing_weight {flag '--inference-dynamic-batching-media-cache-routing-weight', default 1.0, doc 'Media-cache hit weight in equivalent compact-prompt blocks. Default: 1.0.', source 'megatron/training/arguments.py:2333', origin 'argparse'}
							Integer inference_dynamic_batching_vision_embedding_cache_max_bytes {flag '--inference-dynamic-batching-vision-embedding-cache-max-bytes', default 0, doc 'Maximum GPU bytes retained per engine for reusable vision embeddings. Zero disables the cache. Default: 0.', source 'megatron/training/arguments.py:2338', origin 'argparse'}
							Integer inference_dynamic_batching_cuda_graph_mixed_prefill_count {flag '--inference-dynamic-batching-cuda-graph-mixed-prefill-count', default 16, doc 'Number of mixed prefill requests to capture in a cuda graph.', source 'megatron/training/arguments.py:2362', origin 'argparse'}
							inference_dynamic_batching_cuda_graph_sizing_distribution {flag '--inference-dynamic-batching-cuda-graph-sizing-distribution', default 'hybrid', doc 'Spacing of CUDA graph token counts. "hybrid" (default) uses exponential spacing for prefill/mixed graphs and linear spacing for decode-only graphs, whose token counts are capped at max_requests and are far too small for halving to cover well. "exponential" halves from cuda_graph_max_tokens down to tp_size, giving a log-spaced distribution with bounded relative padding. "linear" uses varying linear strides across the range.', source 'megatron/training/arguments.py:2365', origin 'argparse'}
								alternative
