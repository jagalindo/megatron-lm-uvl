	// transformer_config.py:2451-2459 mhc_recompute_layer_num must be a positive integer with 'mhc' recompute
	((recompute_granularity_selective | recompute_activations | moe_layer_recompute) & recompute_modules_mhc & mhc_recompute_layer_num) => mhc_recompute_layer_num >= 1
	// transformer_config.py:2460-2466 'mhc' recompute not supported with fine-grained activation offloading
	((recompute_granularity_selective | recompute_activations | moe_layer_recompute) & recompute_modules_mhc) => !fine_grained_activation_offloading
	// transformer_config.py:2468-2475 'residual_stream' in recompute_modules requires selective granularity
	recompute_modules_residual_stream => (recompute_granularity_selective | recompute_activations | moe_layer_recompute)
	// transformer_config.py:2476-2480 'residual_stream' recompute requires a wide residual stream
	((recompute_granularity_selective | recompute_activations | moe_layer_recompute) & recompute_modules_residual_stream) => wide_residual_num_streams
	// transformer_config.py:2503-2506 residual_stream_recompute_num_layers requires selective recompute with 'residual_stream' in recompute_modules (Experiment 2 attempts 3-5 valid_0060, mut_277/278)
	residual_stream_recompute_num_layers => ((recompute_granularity_selective | recompute_activations | moe_layer_recompute) & recompute_modules_residual_stream)
	// transformer_config.py:2610-2615 offloading attn_proj requires offloading core_attn
	(fine_grained_activation_offloading & offload_modules_attn_proj) => offload_modules_core_attn
	// transformer_config.py:2616-2626 offloading gdp_qkv conflicts with gdp_in_proj recompute
	(fine_grained_activation_offloading & offload_modules_gdp_qkv & (recompute_granularity_selective | recompute_activations | moe_layer_recompute)) => !recompute_modules_gdp_in_proj
	// transformer_config.py:2627-2635 no offloading inside MoE while recomputing the whole MoE layer
	(fine_grained_activation_offloading & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & (recompute_modules_moe | moe_layer_recompute)) => !(offload_modules_moe_act | offload_modules_expert_fc1 | offload_modules_fused_group_mlp)
	// transformer_config.py:2648-2650 offloading fused_group_mlp requires --use-transformer-engine-op-fuser
	(fine_grained_activation_offloading & offload_modules_fused_group_mlp) => use_transformer_engine_op_fuser
	// transformer_config.py:2651-2656 fused_group_mlp offload cannot be combined with expert_fc1 / moe_act offload
	(fine_grained_activation_offloading & offload_modules_fused_group_mlp) => !(offload_modules_expert_fc1 | offload_modules_moe_act)
	// ===== v6: Platform subtree. Environment-dependent checks (installed packages, TE / torch versions, GPU compute capability) as model constraints over the platform_* features (declared by scripts/gen_uvl.py). Versions are encoded as major*100 + minor, e.g. TE 2.18 = 218. =====
	// arguments.py:176 --enable-msc requires the multistorageclient package (Experiment 2 attempt 1 valid_0004)
	enable_msc => platform_has_multistorageclient
	// arguments.py:3986-3999 the kitchen arguments are only registered when the kitchen package is importable (HAVE_KITCHEN); otherwise argparse rejects them at arguments.py:143 (Experiment 2 attempt 1 mut_000)
	(kitchen_config_file | kitchen_recipe_number) => platform_has_kitchen
	// arguments.py:426-432 --non-persistent-ckpt-type local requires nvidia_resiliency_ext
	non_persistent_ckpt_type_local => platform_has_nvidia_resiliency_ext
	// arguments.py:1131-1136 MXFP8 with inference-optimized layers requires FlashInfer >= 0.6.4 (Experiment 2 attempt 1 mut_235/236)
	(fp8_recipe_mxfp8 & transformer_impl_inference_optimized) => platform_has_flashinfer_0_6_4
	// arguments.py:1052 --use-torch-fsdp2 requires torch >= 2.4
	use_torch_fsdp2 => platform_torch_version >= 204
	// arguments.py:1128 --fp4-format requires TE >= 2.7
	fp4 => platform_te_version >= 207
	// arguments.py:1398 --moe-grouped-gemm requires compute capability >= 8
	moe_grouped_gemm => platform_gpu_cc_major >= 8
	// arguments.py:1489-1515 before Blackwell (cc < 10), TP or CP > 1 without FSDP2 / Megatron-FSDP / MoE EP overlap requires CUDA_DEVICE_MAX_CONNECTIONS == 1
	(platform_gpu_cc_major < 10 & (tensor_model_parallel_size > 1 | context_parallel_size > 1) & !use_torch_fsdp2 & !use_megatron_fsdp & !overlap_moe_expert_parallel_comm) => (CUDA_DEVICE_MAX_CONNECTIONS & CUDA_DEVICE_MAX_CONNECTIONS == 1)
	// arguments.py:1550-1580 on Blackwell (cc >= 10), GTP (dense or expert, gtp_weight_remat_size > 1) with CUDA graphs requires CUDA_GRAPHS_USE_NODE_PRIORITY=1. v9: effective impl incl. --enable/--external-cuda-graph, and expert GTP (Experiment 2 attempt 8 mut_515)
	(platform_gpu_cc_major >= 10 & (aux_gtp_weight_remat_size > 1 | (expert_tensor_parallel_num_weight_shards & ((expert_tensor_parallel_size & expert_tensor_parallel_num_weight_shards > expert_tensor_parallel_size) | (!expert_tensor_parallel_size & expert_tensor_parallel_num_weight_shards > tensor_model_parallel_size)))) & (cuda_graph_impl_local | enable_cuda_graph | cuda_graph_impl_transformer_engine | external_cuda_graph | cuda_graph_impl_full_iteration)) => CUDA_GRAPHS_USE_NODE_PRIORITY
	// arguments.py:1649 --qk-clip requires TE >= 2.9
	qk_clip => platform_te_version >= 209
	// arguments.py:1658 --log-max-attention-logit requires TE >= 2.9
	log_max_attention_logit => platform_te_version >= 209
	// arguments.py:1782-1785 TE cross-entropy fusion requires TE >= 2.19
	(cross_entropy_loss_fusion & cross_entropy_fusion_impl_te) => platform_te_version >= 219
	// arguments.py:2020-2022 delay_wgrad_compute with overlap_grad_reduce requires TE >= 2.8
	(delay_wgrad_compute & overlap_grad_reduce) => platform_te_version >= 208
	// arguments.py:2052-2053 fine-grained activation offloading with TE >= 2.10 requires NVTE_CPU_OFFLOAD_V1=1 (Experiment 2 attempt 1 valid_0021)
	(fine_grained_activation_offloading & platform_te_version >= 210) => NVTE_CPU_OFFLOAD_V1
	// transformer_config.py:2080 single grouped MoE weight/bias require TE >= 2.14
	(moe_single_grouped_weight | moe_single_grouped_bias) => platform_te_version >= 214
	// transformer_engine.py:2307 --attn-logit-softcapping requires a TE build whose DotProductAttention exposes softcap (TE 2.18 does not) (Experiment 2 attempt 3 valid_0015, at runtime)
	attn_logit_softcapping => platform_te_has_softcap
	// transformer_config.py:1690-1693 + 1799/1839 + core/utils.py:580 the effective DSA backend (unset defaults to cudnn for dsv4_hybrid, else none) must have its fused kernels installed (Experiment 2 attempts 3-5 mut_380-384)
	((experimental_attention_variant_dsa | experimental_attention_variant_dsv4_hybrid) & (dsa_kernel_backend_cudnn | (experimental_attention_variant_dsv4_hybrid & !dsa_kernel_backend))) => platform_has_cudnn_dsa_kernels
	// transformer_config.py:1799/1839 + core/utils.py:574 tilelang DSA backend needs its kernel packages
	((experimental_attention_variant_dsa | experimental_attention_variant_dsv4_hybrid) & dsa_kernel_backend_tilelang) => platform_has_tilelang_dsa_kernels
	// ===== v11: found by Experiment 3 (real RTX 2080 Ti, cc 7.5) =====
	// transformer_engine.py:2498 TE DotProductAttention: the flash and fused attention backends are unavailable before Ampere -> "No dot product attention backend is available for the provided inputs" (Experiment 3 smoke tests fp16_attn_flash / fp16_attn_fused on Turing; unfused, auto and --transformer-impl local work). Observed with fp16/bf16, head dim 64, causal mask; TE's backend selection also depends on dtype, head dim and mask, so this is the observed case, not TE's full support matrix. At runtime
	(transformer_impl_transformer_engine & (attention_backend_flash | attention_backend_fused)) => platform_gpu_cc_major >= 8
	// ===== v8: CUDA-graph module rules. cuda_graph_modules / cuda_graph_scope_deprecated are or-groups (enum values + deprecated spellings full, full_iteration, full_iteration_inference). Effective values: --enable-cuda-graph = local and --external-cuda-graph = transformer_engine (arguments.py:644-664); --cuda-graph-scope is copied into --cuda-graph-modules; with the local impl moe_router and moe_preprocess are added together (transformer_config.py:3349). APPROXIMATION: the deprecated spellings full_iteration / full_iteration_inference also rewrite cuda_graph_impl / inference_cuda_graph_scope (cuda_graph_config.py:10-13, arguments.py:295-306); rules below use the non-migrated values. =====
	// cuda_graph_config.py:40-42 'full' cannot be combined with other cuda_graph_modules values
	(cuda_graph_modules_full | cuda_graph_scope_deprecated_full) => !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba) | (cuda_graph_modules_full_iteration | cuda_graph_scope_deprecated_full_iteration) | (cuda_graph_modules_full_iteration_inference | cuda_graph_scope_deprecated_full_iteration_inference))
	// cuda_graph_config.py:104-108 at most one deprecated cuda_graph_modules value
	!((cuda_graph_modules_full_iteration | cuda_graph_scope_deprecated_full_iteration) & (cuda_graph_modules_full_iteration_inference | cuda_graph_scope_deprecated_full_iteration_inference))
	// cuda_graph_config.py:116-119 deprecated 'full_iteration' needs cuda_graph_impl none, local or full_iteration
	(cuda_graph_modules_full_iteration | cuda_graph_scope_deprecated_full_iteration) => !(cuda_graph_impl_transformer_engine | external_cuda_graph)
	// cuda_graph_config.py:120-124 deprecated 'full_iteration' needs inference_cuda_graph_scope unset or none
	(cuda_graph_modules_full_iteration | cuda_graph_scope_deprecated_full_iteration) => (!inference_cuda_graph_scope | inference_cuda_graph_scope_none)
	// cuda_graph_config.py:126-129 deprecated 'full_iteration_inference' needs cuda_graph_impl none or local
	(cuda_graph_modules_full_iteration_inference | cuda_graph_scope_deprecated_full_iteration_inference) => !((cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration)
	// cuda_graph_config.py:130-134 deprecated 'full_iteration_inference' needs inference_cuda_graph_scope unset or block
	(cuda_graph_modules_full_iteration_inference | cuda_graph_scope_deprecated_full_iteration_inference) => (!inference_cuda_graph_scope | inference_cuda_graph_scope_block)
	// transformer_config.py:3357-3360 per-layer CUDA graphs: not both moe and moe_router
	((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) => !((cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess)))))
	// transformer_config.py:3361-3364 per-layer CUDA graphs: moe_preprocess only with moe_router
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) & ((cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess))))) => ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess))))
	// transformer_config.py:3365-3369 per-layer CUDA graphs: moe / moe_router graphs only for MoE models (num_experts > 1)
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) & !((num_experts & num_experts != 0) & num_experts > 1)) => !((cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess)))))
	// transformer_config.py:3371-3377 per-layer CUDA graphs: mlp graph needs dense layers (all-MoE moe_layer_freq == 1 has none)
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) & ((num_experts & num_experts != 0) & num_experts > 1) & moe_layer_freq == '1') => !(cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp)
	// transformer_config.py:3378-3384 per-layer CUDA graphs: moe graph only with drop-and-pad MoE
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) & ((num_experts & num_experts != 0) & num_experts > 1) & (!(moe_expert_capacity_factor & moe_expert_capacity_factor >= 0) | !moe_pad_expert_input_to_capacity)) => !(cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe)
	// transformer_config.py:3385-3391 per-layer CUDA graphs: no moe_preprocess graph with alltoall + capacity factor / fp8 router padding (DtoH syncs)
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph)) & ((num_experts & num_experts != 0) & num_experts > 1) & (!(moe_expert_capacity_factor & moe_expert_capacity_factor >= 0) | !moe_pad_expert_input_to_capacity) & moe_token_dispatcher_type_alltoall & ((moe_expert_capacity_factor & moe_expert_capacity_factor >= 0) | moe_router_padding_for_fp8)) => !((cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess))))
	// transformer_config.py:3334-3336 + arguments.py:2083 cuda_graph_modules must be empty with full_iteration (deprecated spellings are dropped by normalisation)
	cuda_graph_impl_full_iteration => !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))
	// transformer_config.py:3343-3344 CUDA graphs (other than full_iteration) not supported with CPU offloading
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph))) => !(cpu_offloading_num_layers > 0)
	// transformer_config.py:3393-3397 full recompute only with full_iteration CUDA graphs
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration) & (recompute_granularity_full & !recompute_activations & !moe_layer_recompute)) => cuda_graph_impl_full_iteration
	// transformer_config.py:3401-3408 transformer_engine graphs: no moe recompute together with a moe_router graph
	((cuda_graph_impl_transformer_engine | external_cuda_graph) & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & (recompute_modules_moe | moe_layer_recompute)) => !(cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router)
	// transformer_config.py:3421-3428 attention dropout: graphed attention must not be recomputed
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration) & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & attention_dropout != 0.0) => ((!(cuda_graph_impl_full_iteration | !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))) & !(cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn)) | !(recompute_modules_core_attn | !recompute_modules))
	// transformer_config.py:3429-3441 hidden dropout: graphed MLP / MoE must not be recomputed
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration) & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & hidden_dropout != 0.0) => (((!(cuda_graph_impl_full_iteration | !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))) & !(cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp)) | !recompute_modules_mlp) & ((!(cuda_graph_impl_full_iteration | !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))) & !(cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe)) | !(recompute_modules_moe | moe_layer_recompute)))
	// transformer_config.py:3442-3448 moe_input_jitter_eps: graphed MoE must not be recomputed
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration) & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & moe_input_jitter_eps) => ((!(cuda_graph_impl_full_iteration | !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))) & !(cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe)) | !(recompute_modules_moe | moe_layer_recompute))
	// transformer_config.py:3450-3469 GTP + local graphs capturing shared experts cannot recompute them under fp8/fp4
	(((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration) & (recompute_granularity_selective | recompute_activations | moe_layer_recompute) & aux_gtp_weight_remat_size > 1 & (cuda_graph_impl_local | enable_cuda_graph) & (fp8 | fp4) & moe_shared_expert_intermediate_size & !moe_shared_expert_overlap & ((cuda_graph_impl_full_iteration | !((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | ((cuda_graph_impl_local | enable_cuda_graph) & ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess)))))) => !recompute_modules_shared_experts
	// transformer_config.py:3473-3483 fine-grained offloading with local graphs: only expert_fc1 / moe_act / fused_group_mlp offload
	(fine_grained_activation_offloading & (cuda_graph_impl_local | enable_cuda_graph)) => !(offload_modules_core_attn | offload_modules_attn_proj | offload_modules_attn_norm | offload_modules_mlp_norm | offload_modules_qkv_linear | offload_modules_gdp_qkv | offload_modules_shortcut_post_norm)
	// transformer_config.py:3484-3487 fine-grained offloading with local graphs: no whole-layer capture (cuda_graph_modules must be non-empty)
	(fine_grained_activation_offloading & (cuda_graph_impl_local | enable_cuda_graph)) => ((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp) | (cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) | (cuda_graph_modules_moe_preprocess | cuda_graph_scope_deprecated_moe_preprocess) | (cuda_graph_modules_mamba | cuda_graph_scope_deprecated_mamba))
	// transformer_config.py:3488-3503 fine-grained offloading: transformer_engine or full_iteration graphs, or local partial-MoE offload without a moe graph
	(fine_grained_activation_offloading & (cuda_graph_impl_local | enable_cuda_graph)) => (offload_modules & !(cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe))
	// transformer_config.py:3504-3506 fine-grained offloading: no token-drop MoE (moe) CUDA graph
	(fine_grained_activation_offloading & ((cuda_graph_impl_local | enable_cuda_graph) | (cuda_graph_impl_transformer_engine | external_cuda_graph) | cuda_graph_impl_full_iteration)) => !(cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe)
	// transformer_config.py:3608-3615 overlap_moe_expert_parallel_comm with transformer_engine graphs: no moe / mlp graph
	(overlap_moe_expert_parallel_comm & (cuda_graph_impl_transformer_engine | external_cuda_graph)) => !((cuda_graph_modules_moe | cuda_graph_scope_deprecated_moe) | (cuda_graph_modules_mlp | cuda_graph_scope_deprecated_mlp))
	// arguments.py:2024-2031 delay_wgrad_compute + overlap_grad_reduce with graphed wgrad needs TE >= 2.12
	(delay_wgrad_compute & overlap_grad_reduce & ((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) & moe_shared_expert_intermediate_size & !moe_shared_expert_overlap))) => platform_te_version >= 212
	// arguments.py:2032-2036 delay_wgrad_compute + overlap_grad_reduce with graphed wgrad needs gradient_accumulation_fusion
	(delay_wgrad_compute & overlap_grad_reduce & ((cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn) | ((cuda_graph_modules_moe_router | cuda_graph_scope_deprecated_moe_router) & moe_shared_expert_intermediate_size & !moe_shared_expert_overlap))) => gradient_accumulation_fusion
	// arguments.py:2037-2040 delay_wgrad_compute + overlap_grad_reduce with an attn graph: no attention bias
	(delay_wgrad_compute & overlap_grad_reduce & (cuda_graph_modules_attn | cuda_graph_scope_deprecated_attn)) => (!add_bias_linear & !add_qkv_bias)
