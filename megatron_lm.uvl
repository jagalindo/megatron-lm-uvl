							vision_pretraining_type {flag '--vision-pretraining-type', default 'classify', doc 'pretraining objectives', source 'megatron/training/arguments.py:3696', origin 'argparse'}
								alternative
									vision_pretraining_type_classify {value 'classify'}
									vision_pretraining_type_inpaint {value 'inpaint'}
									vision_pretraining_type_dino {value 'dino'}
							vision_backbone_type {flag '--vision-backbone-type', default 'vit', doc 'backbone types types', source 'megatron/training/arguments.py:3699', origin 'argparse'}
