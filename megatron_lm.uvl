	// arguments.py:1192 Megatron-FSDP requires CUDA_DEVICE_MAX_CONNECTIONS != 1
	use_megatron_fsdp => (!CUDA_DEVICE_MAX_CONNECTIONS | CUDA_DEVICE_MAX_CONNECTIONS != 1)
	// arguments.py:1195 Megatron-FSDP requires fsdp_dtensor checkpoint format
