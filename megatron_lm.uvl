	overlap_param_gather_with_optimizer_step => ckpt_format_torch
	// arguments.py:1116 --fp8-param-gather requires distributed optimizer, torch fsdp2 or megatron fsdp (inference/no-grad escape ignored)
	fp8_param_gather => (use_distributed_optimizer | use_torch_fsdp2 | use_megatron_fsdp)
	// arguments.py:1121 FP4 and FP8 are mutually exclusive
