							inference_dynamic_batching {flag '--inference-dynamic-batching', default false, doc 'Enable dynamic batching mode.', source 'megatron/training/arguments.py:2197', origin 'argparse'}
							Real inference_dynamic_batching_paused_buffer_size_gb {flag '--inference-dynamic-batching-paused-buffer-size-gb', doc 'Memory used to derive the paused-request block retention budget. This does not reserve blocks from active requests: active requests may use the entire shared pool of usable KV cache blocks. Under allocation pressure, paused requests retain blocks only within this budget and excess paused requests may be evicted.', source 'megatron/training/arguments.py:2212', origin 'argparse'}
							Real inference_dynamic_batching_mamba_memory_ratio {flag '--inference-dynamic-batching-mamba-memory-ratio', doc 'Percentage of memory buffer to allocate for Mamba states. If not specified, allocates Mamba state tensors for each KV cache block. Only used for hybrid models.', source 'megatron/training/arguments.py:2220', origin 'argparse'}
							Integer inference_dynamic_batching_max_requests {flag '--inference-dynamic-batching-max-requests', doc 'Override the inference context`s `max_requests`. By default, `max_requests` is set to the number of blocks in the context`s memory buffer.', source 'megatron/training/arguments.py:2228', origin 'argparse'}
							Integer inference_dynamic_batching_max_tokens {flag '--inference-dynamic-batching-max-tokens', doc 'Override the inference context`s default `max_tokens`.', source 'megatron/training/arguments.py:2233', origin 'argparse'}
							inference_dynamic_batching_track_paused_request_events {flag '--inference-dynamic-batching-track-paused-request-events', default false, doc 'Track paused request ids by adding `paused` events to each request`s event history. This has a very minor impact on latency.', source 'megatron/training/arguments.py:2245', origin 'argparse'}
							inference_dynamic_batching_track_generated_token_events {flag '--inference-dynamic-batching-track-generated-token-events', default false, doc 'Track per-token events with timestamps for each generated token. When enabled, each generated token creates a GENERATED_TOKEN event with a timestamp, useful for per-token latency analysis.', source 'megatron/training/arguments.py:2250', origin 'argparse'}
							decode_only_cuda_graphs {flag '--decode-only-cuda-graphs', default false, doc 'Only use cuda graphs for decode-only steps, not prefill and mixed steps.', source 'megatron/training/arguments.py:2255', origin 'argparse'}
							inference_cuda_graph_all_prefills {flag '--inference-cuda-graph-all-prefills', default false, doc 'Extend prefill/mixed CUDA graph capture up to `max_tokens`. By default, all graphs are limited by the decode limit of `max_requests * (num_speculative_tokens + 1)`.', source 'megatron/training/arguments.py:2258', origin 'argparse'}
							enable_chunked_prefill {flag '--enable-chunked-prefill', default false, doc 'Enable chunked prefill (disabled by default)', source 'megatron/training/arguments.py:2277', origin 'argparse'}
							inference_dynamic_batching_enable_prefix_caching {flag '--inference-dynamic-batching-prefix-caching', default false, doc 'Enable/disable prefix caching for dynamic batching inference. When disabled, KV cache blocks cannot be shared between requests with identical prompt prefixes.', source 'megatron/training/arguments.py:2282', origin 'argparse'}
							inference_dynamic_batching_allow_stale_multimodal_embeddings {flag '--inference-dynamic-batching-allow-stale-multimodal-embeddings', default false, doc 'Allow request-local and cached multimodal embeddings to survive suspend/resume and generation-epoch changes. Use only when model weights do not change across these boundaries.', source 'megatron/training/arguments.py:2343', origin 'argparse'}
							Real inference_dynamic_batching_prefix_caching_mamba_gb {flag '--inference-dynamic-batching-prefix-caching-mamba-gb', doc 'GPU memory budget (in GB) for the Mamba state cache used by prefix caching on hybrid models. When set, Mamba states at block boundaries are cached for reuse. This budget covers both the durable cache (the ssm_states/conv_states slots reused across requests) and the per-step extraction scratch (the intermediate_ssm_out/intermediate_conv_out buffers, sized to min(ceil(max_tokens / block_size), 3 * max_requests) slots); the scratch is reserved first, so a smaller max_tokens (or max_requests) shrinks the scratch and leaves more durable slots.', source 'megatron/training/arguments.py:2349', origin 'argparse'}
							offset_sampling_seed_by_dp_rank {flag '--use-same-sampling-seed-across-dp-ranks', default true, doc 'Use the same inference sampling seed on every data-parallel rank. --deterministic-mode also uses the same seed on every DP rank.', source 'megatron/training/arguments.py:2382', origin 'argparse'}
							inference_text_gen_server_logging {flag '--inference-text-gen-server-logging', default false, doc 'Enable per-request logging in the inference text generation server.', source 'megatron/training/arguments.py:2403', origin 'argparse'}
							inference_wandb_logging {flag '--inference-wandb-logging', default false, doc 'Enable inference wandb logging.', source 'megatron/training/arguments.py:2406', origin 'argparse'}
							Integer inference_coordinator_port {flag '--inference-coordinator-port', doc 'This port will be used to setup the inference coordinator on node-0', source 'megatron/training/arguments.py:2408', origin 'argparse'}
							inference_use_synchronous_zmq_collectives {flag '--inference-use-synchronous-zmq-collectives', default false, doc 'Use synchronous ZMQ collectives for inference. Helps in reducing performance variability for MoEs.', source 'megatron/training/arguments.py:2416', origin 'argparse'}
							inference_disable_ep_consensus {flag '--inference-disable-ep-consensus', default false, doc 'Skip the EP-group consensus all-reduce in the inference engine control loop and step on local state only. Pause/unpause take effect as soon as the signal is delivered to a rank. Only safe when EP coordination is not required (e.g. ep_world_size == 1).', source 'megatron/training/arguments.py:2418', origin 'argparse'}
							String inference_shards {flag '--inference-shards', doc 'Partition the world into independent inference models, each with its own parallelism, e.g. "tp=2,role=prefill+tp=1,dp=2,role=decode". Shards are separated by "+" or ";"; per-shard keys are tp,pp,ep,expt_tp,dp (each defaults to 1) and must partition the full world. Tagging shards role=prefill|decode enables disaggregated inference (prefill hands KV to the decode pool); a dp>1 decode shard is several independent decode instances.', source 'megatron/training/arguments.py:2423', origin 'argparse'}
					TransformerConfigurationGroup {abstract, title 'transformer configuration', function '_add_network_size_args', doc 'TransformerConfig: Configuration object for megatron-core transformers. The initialization function has an argument for each parameter, including those in ModelParallelConfig.', parameters 259}
						mandatory
