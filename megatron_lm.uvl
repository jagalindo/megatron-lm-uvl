	// arguments.py:579 --rl-generation-lag must be >= -1
	(perform_rl_step & rl_generation_lag) => rl_generation_lag >= -1
	// arguments.py:582 positive --rl-generation-lag requires --rl-partial-rollouts
	(perform_rl_step & rl_generation_lag & rl_generation_lag > 0) => rl_partial_rollouts
	// arguments.py:584 submission granularity other than B requires --rl-partial-rollouts
	perform_rl_step => (rl_submission_granularity_B | rl_partial_rollouts)
