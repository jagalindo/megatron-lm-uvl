					OneLoggerGroup {abstract, title 'one logger', function '_add_one_logger_args', parameters 6}
						mandatory
							String one_logger_project {flag '--one-logger-project', default 'megatron-lm', doc 'The one-logger project name. Will ignore if --no-one-logger is set', source 'megatron/training/arguments.py:2739', origin 'argparse'}
							String app_tag_run_version {flag '--app-tag-run-version', default '0.0.0', doc 'The version of the training of which current job is part of. It will be used to track the changes in the application side which might change the performance baseline', source 'megatron/training/arguments.py:2751', origin 'argparse'}
