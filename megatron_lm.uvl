	(use_megatron_fsdp & megatron_fsdp_version_2) => !use_distributed_optimizer
	// arguments.py:1163 Megatron-FSDP does not support single grouped MoE weight/bias
	use_megatron_fsdp => (!moe_single_grouped_weight & !moe_single_grouped_bias)
	// arguments.py:1170 Megatron-FSDP supports only sgd/adam
